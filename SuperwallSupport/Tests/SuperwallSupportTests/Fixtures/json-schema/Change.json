{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "changeSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectId": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "entity": {
      "type": "string"
    },
    "entityId": {
      "type": "string"
    },
    "op": {
      "type": "string",
      "enum": [
        "upsert",
        "delete",
        "tombstone"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "conversationId": {
      "type": "string"
    },
    "mutationId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "at": {
      "type": "string"
    }
  },
  "required": [
    "changeSeq",
    "projectId",
    "entity",
    "entityId",
    "op",
    "version",
    "at"
  ],
  "additionalProperties": true
}
