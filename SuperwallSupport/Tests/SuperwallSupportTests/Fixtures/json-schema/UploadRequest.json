{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "file",
        "diagnostics"
      ]
    },
    "filename": {
      "type": "string",
      "maxLength": 255
    },
    "mime": {
      "type": "string",
      "maxLength": 127
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26214400
    },
    "sha256": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "filename",
    "mime",
    "bytes",
    "sha256"
  ],
  "additionalProperties": true
}
