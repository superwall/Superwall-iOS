{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hello"
          ]
        },
        "protocol": {
          "type": "string"
        },
        "sessionToken": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "afterId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol",
        "sessionToken",
        "conversationId",
        "after"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "typing"
          ]
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "active"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ping"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    }
  ]
}
