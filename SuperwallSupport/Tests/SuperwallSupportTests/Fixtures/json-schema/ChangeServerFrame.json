{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ready"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "superwall-inbox/1"
          ]
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "head": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "protocol",
        "after",
        "head"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "change"
          ]
        },
        "change": {
          "type": "object",
          "properties": {
            "changeSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "projectId": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "entity": {
              "type": "string"
            },
            "entityId": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "upsert",
                "delete",
                "tombstone"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "conversationId": {
              "type": "string"
            },
            "mutationId": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
            },
            "at": {
              "type": "string"
            }
          },
          "required": [
            "changeSeq",
            "projectId",
            "entity",
            "entityId",
            "op",
            "version",
            "at"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "change"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "resync"
          ]
        },
        "reason": {
          "type": "string"
        },
        "head": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "reason",
        "head"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "presence"
          ]
        },
        "conversationId": {
          "type": "string"
        },
        "viewers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userId": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "viewing",
                  "replying"
                ]
              },
              "expiresAt": {
                "type": "string"
              }
            },
            "required": [
              "userId",
              "state",
              "expiresAt"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "type",
        "conversationId",
        "viewers"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "collision"
          ]
        },
        "conversationId": {
          "type": "string"
        },
        "mutationId": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "seenPublicSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastPublicSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "conversationId",
        "mutationId",
        "seenPublicSeq",
        "lastPublicSeq"
      ],
      "additionalProperties": true
    }
  ]
}
