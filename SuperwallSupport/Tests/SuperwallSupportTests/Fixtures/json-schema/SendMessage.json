{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientMessageId": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "maxLength": 10000
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attachmentId": {
            "type": "string"
          }
        },
        "required": [
          "attachmentId"
        ],
        "additionalProperties": true
      }
    },
    "seenSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "clientMessageId",
    "text"
  ],
  "additionalProperties": true
}
