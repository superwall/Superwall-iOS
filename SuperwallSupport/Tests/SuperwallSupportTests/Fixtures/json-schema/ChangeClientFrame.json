{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hello"
          ]
        },
        "protocol": {
          "type": "string"
        },
        "clientId": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "protocol",
        "clientId",
        "after"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "presence"
          ]
        },
        "conversationId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "viewing",
            "replying"
          ]
        }
      },
      "required": [
        "type",
        "conversationId",
        "state"
      ],
      "additionalProperties": true
    }
  ]
}
