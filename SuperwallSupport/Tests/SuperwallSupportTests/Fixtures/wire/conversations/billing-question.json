{
  "name": "billing-question",
  "description": "A person asks about a charge; the agent streams an answer; a teammate leaves a note; a card offers a switch.",
  "script": [
    {
      "op": "person",
      "clientMessageId": "cm-billing-1",
      "text": "Why was I charged $59.99?"
    },
    {
      "op": "status",
      "state": "typing"
    },
    {
      "op": "wait",
      "millis": 50
    },
    {
      "op": "stream",
      "chunks": [
        "You ",
        "renewed ",
        "the ",
        "Yearly ",
        "plan ",
        "on ",
        "Nov ",
        "4. ",
        "That's ",
        "the ",
        "$59.99 ",
        "charge."
      ],
      "pauseAfter": {
        "chunks": 3,
        "millis": 400
      }
    },
    {
      "op": "append",
      "draft": {
        "kind": "note",
        "visibility": "internal",
        "author": {
          "type": "human",
          "name": "Maya"
        },
        "text": "Renewal was on time. No refund needed."
      }
    },
    {
      "op": "person",
      "clientMessageId": "cm-billing-2",
      "text": "Can I switch to monthly instead?"
    },
    {
      "op": "append",
      "draft": {
        "kind": "card",
        "visibility": "public",
        "author": {
          "type": "agent",
          "name": "Assistant"
        },
        "text": "You can switch to Monthly at $7.99/month from Nov 4, 2027. Reply 'switch' or 'not now'.",
        "card": {
          "v": 1,
          "id": "card_00000000000000000000000001",
          "card": "plan_choice",
          "tpl": "plan_choice@2",
          "ui": 1,
          "text": "You can switch to Monthly at $7.99/month from Nov 4, 2027. Reply 'switch' or 'not now'.",
          "nodes": [
            {
              "t": "card",
              "n": 3
            },
            {
              "t": "text",
              "role": "title",
              "value": "Switch to Monthly"
            },
            {
              "t": "kv",
              "label": "Price",
              "value": "$7.99/month"
            },
            {
              "t": "kv",
              "label": "Starts",
              "value": "Nov 4, 2027, at your renewal"
            }
          ],
          "actions": {
            "switch": {
              "kind": "client",
              "do": "purchase",
              "productId": "monthly_8",
              "token": "signed.fixture.token"
            },
            "not_now": {
              "kind": "reply",
              "reply": "Not now"
            }
          },
          "resolved": {
            "text": "You switched to Monthly."
          }
        }
      }
    },
    {
      "op": "status",
      "state": "waiting_user"
    }
  ],
