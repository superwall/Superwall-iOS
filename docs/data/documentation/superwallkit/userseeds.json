{"abstract":[{"type":"text","text":"Choose whether identified users receive a seed derived from their user ID."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/userseeds"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"user.seed"},{"text":" is a number from 0 to 99 that can be used in campaign audience filters.","type":"text"},{"text":" ","type":"text"},{"text":"Anonymous users receive a randomly generated seed. To derive a consistent seed from the","type":"text"},{"text":" ","type":"text"},{"text":"ID supplied to ","type":"text"},{"type":"codeVoice","code":"identify(userId:)"},{"text":", configure ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/enableUserIdSeed","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let options = SuperwallOptions()","options.enableUserIdSeed = true","Superwall.configure(apiKey: \"YOUR_API_KEY\", options: options)","","\/\/ Call when your authentication provider supplies the user's ID.","Superwall.shared.identify(userId: supabaseUserId)"]},{"type":"paragraph","inlineContent":[{"text":"The option defaults to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", which keeps the existing behavior: the seed is only derived","type":"text"},{"text":" ","type":"text"},{"text":"from the user ID if Superwall has turned this on for your app.","type":"text"}]},{"type":"heading","level":2,"text":"Identity changes","anchor":"Identity-changes"},{"type":"paragraph","inlineContent":[{"text":"Set the option before configuring the SDK. On identification with a new ID, the SDK uses the","type":"text"},{"text":" ","type":"text"},{"text":"existing SHA256-based bucketing algorithm. The same ID produces the same bucket across installs","type":"text"},{"text":" ","type":"text"},{"text":"and devices using this algorithm. Multiple IDs can share a bucket. Leading and trailing whitespace","type":"text"},{"text":" ","type":"text"},{"text":"is removed from the ID before hashing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Identification can change an anonymous user’s bucket. Resetting the SDK generates a new anonymous","type":"text"},{"text":" ","type":"text"},{"text":"seed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The SDK persists the seed. Identifying an already identified user with the same ID returns early,","type":"text"},{"text":" ","type":"text"},{"text":"so enabling this option does not migrate their existing seed, including after an app restart.","type":"text"},{"text":" ","type":"text"},{"text":"Avoid resetting existing users just to change their seed, since resetting also clears user state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Changing seed behavior can change which audiences match. The seed is an audience variable;","type":"text"},{"text":" ","type":"text"},{"text":"it does not directly select a campaign’s experiment variant.","type":"text"}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/UserSeeds","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"User seeds","modules":[{"name":"SuperwallKit"}]},"references":{"https://superwall.com":{"identifier":"https:\/\/superwall.com","url":"https:\/\/superwall.com","type":"link","title":"Superwall","titleInlineContent":[{"type":"text","text":"Superwall"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/enableUserIdSeed":{"title":"enableUserIdSeed","abstract":[{"type":"text","text":"Derives "},{"type":"codeVoice","code":"user.seed"},{"type":"text","text":" from the ID passed to "},{"type":"codeVoice","code":"identify(userId:)"},{"type":"text","text":". Defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/enableUserIdSeed","kind":"symbol","role":"symbol","url":"\/documentation\/superwallkit\/superwalloptions\/enableuseridseed","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableUserIdSeed","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallKit":{"url":"\/documentation\/superwallkit\/superwallkit","title":"`SuperwallKit`","role":"collectionGroup","kind":"article","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit","abstract":[{"type":"text","text":"The client SDK for "},{"isActive":true,"type":"reference","identifier":"https:\/\/superwall.com"},{"type":"text","text":", a service that lets you remotely configure, present and iterate paywalls – helping you find winners quickly."}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"url":"\/documentation\/superwallkit","title":"SuperwallKit","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","abstract":[]}}}