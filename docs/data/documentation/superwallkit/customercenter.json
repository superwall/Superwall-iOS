{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The Customer Center lets users restore purchases, manage or cancel a subscription, request a","type":"text"},{"text":" ","type":"text"},{"text":"refund, change plans, contact support, answer exit surveys and open any subscription for its details — all","type":"text"},{"text":" ","type":"text"},{"text":"without leaving your app. It ships with sensible defaults and is fully configurable, so you can","type":"text"},{"text":" ","type":"text"},{"text":"tailor which paths appear, their titles, surveys and accent colour to match your app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Customer Center requires ","type":"text"},{"inlineContent":[{"type":"text","text":"iOS 15.0+"}],"type":"strong"},{"text":".","type":"text"}]},{"anchor":"Presenting-from-UIKit","type":"heading","text":"Presenting from UIKit","level":3},{"type":"paragraph","inlineContent":[{"text":"Present it over your current view controller with ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["Superwall.shared.presentCustomerCenter()"]},{"type":"paragraph","inlineContent":[{"text":"Or use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController","isActive":true,"type":"reference"},{"text":" yourself. Present it modally:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let customerCenter = CustomerCenterViewController(delegate: myDelegate)","present(customerCenter, animated: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or push it onto a navigation controller of your own, which is what you want when the Customer"},{"type":"text","text":" "},{"type":"text","text":"Center is a row in your own settings screen:"}]},{"syntax":"swift","type":"codeListing","code":["let customerCenter = CustomerCenterViewController(","  presentationStyle: .embedded,","  delegate: myDelegate",")","navigationController?.pushViewController(customerCenter, animated: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An embedded Customer Center renders into your navigation bar and leaves it alone — your title, your"},{"type":"text","text":" "},{"type":"text","text":"back button, your appearance, your swipe-to-go-back. It adds no close button, since your stack"},{"type":"text","text":" "},{"type":"text","text":"already provides the way back. Its own screen — the detail for a subscription — is pushed onto"},{"type":"text","text":" "},{"type":"text","text":"your stack as a further view controller, so it behaves like any other screen you pushed yourself."}]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"CustomerCenterViewController","type":"codeVoice"},{"type":"text","text":" you construct yourself is yours, and the SDK does not"},{"type":"text","text":" "},{"type":"text","text":"track it. "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","isActive":true,"type":"reference"},{"type":"text","text":" will present"},{"type":"text","text":" "},{"type":"text","text":"a second, independent Customer Center over the top of one you pushed, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/dismissCustomerCenter(completion:)","isActive":true,"type":"reference"},{"type":"text","text":" only dismisses the one the SDK presented — it"},{"type":"text","text":" "},{"type":"text","text":"does nothing to yours. Pick one entry point per screen: let the SDK present it, or own the"},{"type":"text","text":" "},{"type":"text","text":"lifecycle of the controller you construct."}]}],"name":"Important","type":"aside"},{"level":3,"anchor":"Presenting-from-SwiftUI","text":"Presenting from SwiftUI","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)"},{"type":"text","text":" modifier to present it as a sheet:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","  @State private var showsCustomerCenter = false","","  var body: some View {","    Button(\"Manage Subscription\") {","      showsCustomerCenter = true","    }","    .presentSuperwallCustomerCenter(isPresented: $showsCustomerCenter)","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or embed "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","isActive":true},{"type":"text","text":" directly in your own navigation stack:"}],"type":"paragraph"},{"syntax":"swift","code":["CustomerCenterView(navigationOptions: .init(style: .embedded))"],"type":"codeListing"},{"level":3,"anchor":"Presenting-from-Objective-C","text":"Presenting from Objective-C","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"presentCustomerCenterWithConfiguration:from:delegate:onDismiss:"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"objc","code":["[Superwall.sharedInstance presentCustomerCenterWithConfiguration:nil","                                                              from:nil","                                                          delegate:myDelegate","                                                         onDismiss:nil];"],"type":"codeListing"},{"anchor":"Configuring-the-Customer-Center","level":2,"text":"Configuring the Customer Center","type":"heading"},{"inlineContent":[{"text":"Set the default configuration via ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true},{"text":" before calling","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Superwall.configure(apiKey:purchaseController:options:completion:)"},{"text":", or pass a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration","isActive":true},{"text":" directly to a presentation call to override it for that","type":"text"},{"text":" ","type":"text"},{"text":"presentation only.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let options = SuperwallOptions()","","let cancelSurvey = CustomerCenterConfiguration.FeedbackSurvey(","  id: \"cancel_survey\",","  title: \"Why are you cancelling?\",","  options: [","    .tooExpensive,","    .init(id: \"dont_use\", title: \"Don't use it enough\"),","    .boughtByMistake","  ]",")","","options.customerCenter = CustomerCenterConfiguration(","  managementScreen: .init(","    paths: [","      .restore,","      .changePlan,","      .refund,","      .manageSubscription(survey: cancelSurvey),","      .url(URL(string: \"https:\/\/mycompany.com\/faq\")!, title: \"FAQ\"),","      .contactSupport","    ]","  ),","  noPurchasesScreen: .init(","    paths: [.restore]","  ),","  support: .init(email: \"support@mycompany.com\")",")","","Superwall.configure(apiKey: \"MY_API_KEY\", options: options)"],"type":"codeListing"},{"inlineContent":[{"text":"Every path is optional and reorderable. Built-in path types (","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"cover restoring purchases, managing or cancelling a subscription, requesting a refund, changing","type":"text"},{"text":" ","type":"text"},{"text":"plans, and contacting support; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/url(_:openMethod:)","type":"reference"},{"text":" ","type":"text"},{"text":"opens a URL either in-app or externally, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","type":"reference"},{"text":" ","type":"text"},{"text":"lets you handle an action entirely yourself via the delegate.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every path type but "},{"type":"codeVoice","code":"url"},{"type":"text","text":" names its own row, so "},{"type":"codeVoice","code":"title"},{"type":"text","text":" on "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path","isActive":true},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"optional and overrides that default. A "},{"type":"codeVoice","code":"url"},{"type":"text","text":" row needs a title, and "},{"type":"codeVoice","code":".url(_:title:)"},{"type":"text","text":" asks for one:"},{"type":"text","text":" "},{"type":"text","text":"a URL could be anything, and its host is the same across all of your own links, so deriving one"},{"type":"text","text":" "},{"type":"text","text":"would render your FAQ, terms and privacy rows identically."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For the survey, ","type":"text"},{"type":"codeVoice","code":".cancellation"},{"text":" is the built-in one the default configuration uses:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".manageSubscription(survey: .cancellation)"},{"text":". A survey’s options can mix the localized built-ins","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":".tooExpensive"},{"text":", ","type":"text"},{"type":"codeVoice","code":".dontUse"},{"text":", ","type":"text"},{"type":"codeVoice","code":".boughtByMistake"},{"text":") with your own. A survey without a ","type":"text"},{"type":"codeVoice","code":"title"},{"text":" asks","type":"text"},{"text":" ","type":"text"},{"text":"“Why are you cancelling?” on a manage-subscription path, so give it a title anywhere else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each path also has an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":", reported as ","type":"text"},{"type":"codeVoice","code":"path_id"},{"type":"text","text":" on Customer Center events. You don’t need to set"},{"type":"text","text":" "},{"type":"text","text":"it: a built-in path uses its type ("},{"code":"restore","type":"codeVoice"},{"type":"text","text":", "},{"code":"refund","type":"codeVoice"},{"type":"text","text":", "},{"code":"manage_subscription","type":"codeVoice"},{"type":"text","text":" and so on), a "},{"code":"url","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"path uses its host and path ("},{"code":"mycompany.com\/faq","type":"codeVoice"},{"type":"text","text":") and a "},{"code":"custom","type":"codeVoice"},{"type":"text","text":" path uses its identifier. Pass your own "},{"code":"id","type":"codeVoice"},{"type":"text","text":" only when two paths"},{"type":"text","text":" "},{"type":"text","text":"on the same screen would otherwise share one, such as two "},{"code":"refund","type":"codeVoice"},{"type":"text","text":" paths with different windows."}]},{"level":3,"text":"Warning customers about old versions","type":"heading","anchor":"Warning-customers-about-old-versions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Customer Center can show a banner asking the customer to update. By default it finds the"},{"type":"text","text":" "},{"type":"text","text":"published version itself, by looking your app up on the App Store:"}]},{"syntax":"swift","code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  warnsAboutUpdates: true          \/\/ on by default",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"latestAppVersion"},{"type":"text","text":" to skip the lookup and warn against a version you control, which is what"},{"type":"text","text":" "},{"type":"text","text":"you want if you gate support on a specific build:"}]},{"syntax":"swift","code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  latestAppVersion: \"2.1.0\"",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The banner appears only when the installed version is "},{"inlineContent":[{"text":"older","type":"text"}],"type":"emphasis"},{"text":" than the published one — never when","type":"text"},{"text":" ","type":"text"},{"text":"it merely differs. It is skipped entirely on TestFlight, sandbox and simulator builds, whose","type":"text"},{"text":" ","type":"text"},{"text":"version is normally ahead of the App Store. Set ","type":"text"},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" to stop the","type":"text"},{"text":" ","type":"text"},{"text":"lookup without turning the banner off. Any failure — offline, no listing found, an unparseable","type":"text"},{"text":" ","type":"text"},{"text":"version — hides the banner and logs under the ","type":"text"},{"type":"codeVoice","code":"customerCenter"},{"text":" scope.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The lookup result is cached for 24 hours, and only the bundle identifier is sent. Because"},{"type":"text","text":" "},{"type":"text","text":"it happens after the screen has loaded, the banner animates in a moment later rather than being"},{"type":"text","text":" "},{"type":"text","text":"there on first paint."}],"type":"paragraph"}]},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"Apple phases a release in over seven days, but the lookup sees the new version as soon","type":"text"},{"text":" ","type":"text"},{"text":"as it goes live. For the first few days of a release, some customers are told to update to a","type":"text"},{"text":" ","type":"text"},{"text":"build that hasn’t reached them yet. If that matters for your app, set ","type":"text"},{"type":"codeVoice","code":"latestAppVersion"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"raise it on your own schedule, or set ","type":"text"},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]},{"text":"The Delegate","type":"heading","level":2,"anchor":"The-Delegate"},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegate","type":"reference"},{"text":" (or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegateObjc","type":"reference"},{"text":" from Objective-C) to","type":"text"},{"text":" ","type":"text"},{"text":"observe and, where relevant, gate what happens in the Customer Center:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["final class MyCustomerCenterDelegate: CustomerCenterDelegate {","  func customerCenterShouldRestorePurchases() async -> Bool {","    true","  }","","  func customerCenterDidSelectAction(_ action: CustomerCenterAction, pathId: String, purchase: CustomerCenterPurchase?) {","    print(\"Customer Center path \\(pathId) selected: \\(action)\")","  }","","  func customerCenterDidCompleteSurvey(surveyId: String, optionId: String, action: CustomerCenterAction, pathId: String) {","    print(\"Survey \\(surveyId) answered with \\(optionId)\")","  }","","  func customerCenterDidCompleteRefundRequest(productId: String, status: CustomerCenterRefundStatus) {","    print(\"Refund request for \\(productId) finished with status \\(status)\")","  }","","  func customerCenterDidDismiss() {","    print(\"Customer Center dismissed\")","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view controller does not retain its delegate — either keep a strong reference to it yourself,"},{"type":"text","text":" "},{"type":"text","text":"or pass it to "},{"type":"codeVoice","code":"presentCustomerCenter(delegate:)"},{"type":"text","text":", which retains it for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"presentation."}]},{"type":"paragraph","inlineContent":[{"text":"In SwiftUI, use the equivalent modifiers instead of a delegate:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["CustomerCenterView()","  .onCustomerCenterShouldRestore { true }","  .onCustomerCenterAction { action, pathId, purchase in print(action, pathId) }","  .onCustomerCenterSurveyResponse { surveyId, optionId, action, pathId in print(surveyId, optionId) }","  .onCustomerCenterRefundRequest { productId, status in print(productId, status) }","  .onCustomerCenterDismiss { print(\"dismissed\") }"]},{"text":"Events","type":"heading","level":2,"anchor":"Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Customer Center fires the following "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallEvent","type":"reference","isActive":true},{"type":"text","text":" cases, which you can observe via"},{"type":"text","text":" "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/handleSuperwallEvent(withInfo:)","type":"reference","isActive":true},{"type":"text","text":" alongside all other SDK events:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"customerCenterOpen"},{"text":": the Customer Center is presented.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterClose","type":"codeVoice"},{"text":": the Customer Center is dismissed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterAction","type":"codeVoice"},{"text":": the user taps a path.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterSurveyResponse"},{"type":"text","text":": the user answers a survey attached to a path."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"customerCenterRefundRequest"},{"type":"text","text":": a refund request finishes."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Limitations","type":"heading","level":2,"text":"Limitations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Requires iOS 15.0+. On earlier versions, presentation calls are unavailable at compile time.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A purchase whose product has no display name is headed by the entitlement it unlocks, or by"},{"type":"text","text":" "},{"type":"text","text":"nothing — never by the product identifier. Today that is every web (Stripe, Paddle) purchase,"},{"type":"text","text":" "},{"type":"text","text":"because the product catalogue doesn’t return a name yet; the name is used as soon as it does."},{"text":" ","type":"text"},{"text":"An App Store product has one once it is localized in App Store Connect — before that, StoreKit","type":"text"},{"text":" ","type":"text"},{"text":"reports an empty display name, which is treated the same way.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Promotional offers are not yet supported as a Customer Center path."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remote configuration of the Customer Center from the Superwall dashboard is coming; today it’s","type":"text"},{"text":" ","type":"text"},{"text":"configured entirely in code via ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"A native, self-service screen where users can view and manage their subscriptions and purchases."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenter"},"sections":[],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SuperwallKit"}],"title":"Customer Center"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/customercenter"]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType/url(_:openMethod:)":{"abstract":[{"text":"Opens a URL. Unlike the other types, a URL has no name the SDK can give it, so set the","type":"text"},{"text":" ","type":"text"},{"text":"row’s title on ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path\/title","isActive":true},{"text":" — the ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path\/url(_:title:openMethod:id:survey:)","isActive":true},{"text":" shorthand","type":"text"},{"text":" ","type":"text"},{"text":"requires one. Without a title the row shows the URL’s host, which is the same for every","type":"text"},{"text":" ","type":"text"},{"text":"link to one site, so FAQ, terms and privacy would read identically.","type":"text"}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/url(_:openMethod:)","url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype\/url(_:openmethod:)","type":"topic","title":"CustomerCenterConfiguration.PathType.url(_:openMethod:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"url"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"openMethod"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit27CustomerCenterConfigurationC10OpenMethodO","text":"OpenMethod"},{"kind":"text","text":")"}],"role":"symbol","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterViewController":{"url":"\/documentation\/superwallkit\/customercenterviewcontroller","abstract":[{"type":"text","text":"A UIKit container for "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerCenterViewController","kind":"identifier"}],"navigatorTitle":[{"text":"CustomerCenterViewController","kind":"identifier"}],"title":"CustomerCenterViewController","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType":{"navigatorTitle":[{"text":"PathType","kind":"identifier"}],"abstract":[{"type":"text","text":"The kinds of path the Customer Center supports."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype","type":"topic","title":"CustomerCenterConfiguration.PathType","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PathType","kind":"identifier"}],"role":"symbol","kind":"symbol"},"https://superwall.com":{"url":"https:\/\/superwall.com","type":"link","identifier":"https:\/\/superwall.com","title":"Superwall","titleInlineContent":[{"type":"text","text":"Superwall"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType/custom(identifier:)":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","role":"symbol","url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype\/custom(identifier:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"custom","kind":"identifier"},{"text":"(","kind":"text"},{"text":"identifier","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[],"type":"topic","title":"CustomerCenterConfiguration.PathType.custom(identifier:)","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/customerCenter":{"url":"\/documentation\/superwallkit\/superwalloptions\/customercenter","abstract":[{"type":"text","text":"Configures the Customer Center presented via "},{"identifier":"