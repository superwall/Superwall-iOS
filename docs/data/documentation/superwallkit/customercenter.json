{"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"abstract":[{"text":"A native, self-service screen where users can view and manage their subscriptions and purchases.","type":"text"}],"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenter","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"The Customer Center lets users restore purchases, manage or cancel a subscription, request a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"refund, change plans, contact support, answer exit surveys and open any subscription for its details — all"},{"type":"text","text":" "},{"type":"text","text":"without leaving your app. It ships with sensible defaults and is fully configurable, so you can"},{"type":"text","text":" "},{"type":"text","text":"tailor which paths appear, their titles, surveys and accent colour to match your app."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The Customer Center requires ","type":"text"},{"inlineContent":[{"type":"text","text":"iOS 15.0+"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Presenting from UIKit","anchor":"Presenting-from-UIKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Present it over your current view controller with "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["Superwall.shared.presentCustomerCenter()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController"},{"text":" yourself. Present it modally:","type":"text"}]},{"type":"codeListing","code":["let customerCenter = CustomerCenterViewController(delegate: myDelegate)","present(customerCenter, animated: true)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or push it onto a navigation controller of your own, which is what you want when the Customer"},{"type":"text","text":" "},{"type":"text","text":"Center is a row in your own settings screen:"}]},{"type":"codeListing","code":["let customerCenter = CustomerCenterViewController(","  presentationStyle: .embedded,","  delegate: myDelegate",")","navigationController?.pushViewController(customerCenter, animated: true)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An embedded Customer Center renders into your navigation bar and leaves it alone — your title, your","type":"text"},{"text":" ","type":"text"},{"text":"back button, your appearance, your swipe-to-go-back. It adds no close button, since your stack","type":"text"},{"text":" ","type":"text"},{"text":"already provides the way back. Its own screen — the detail for a subscription — is pushed onto","type":"text"},{"text":" ","type":"text"},{"text":"your stack as a further view controller, so it behaves like any other screen you pushed yourself.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"CustomerCenterViewController","type":"codeVoice"},{"text":" you construct yourself is yours, and the SDK does not","type":"text"},{"text":" ","type":"text"},{"text":"track it. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)"},{"text":" will present","type":"text"},{"text":" ","type":"text"},{"text":"a second, independent Customer Center over the top of one you pushed, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/dismissCustomerCenter(completion:)"},{"text":" only dismisses the one the SDK presented — it","type":"text"},{"text":" ","type":"text"},{"text":"does nothing to yours. Pick one entry point per screen: let the SDK present it, or own the","type":"text"},{"text":" ","type":"text"},{"text":"lifecycle of the controller you construct.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"},{"anchor":"Presenting-from-SwiftUI","text":"Presenting from SwiftUI","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","isActive":true},{"type":"text","text":" modifier to present it as a sheet:"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsView: View {","  @State private var showsCustomerCenter = false","","  var body: some View {","    Button(\"Manage Subscription\") {","      showsCustomerCenter = true","    }","    .presentSuperwallCustomerCenter(isPresented: $showsCustomerCenter)","  }","}"]},{"type":"paragraph","inlineContent":[{"text":"Or embed ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","type":"reference","isActive":true},{"text":" directly in your own navigation stack:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["CustomerCenterView(navigationOptions: .init(style: .embedded))"]},{"anchor":"Presenting-from-Objective-C","text":"Presenting from Objective-C","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"presentCustomerCenterWithConfiguration:from:delegate:onDismiss:"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"objc","code":["[Superwall.sharedInstance presentCustomerCenterWithConfiguration:nil","                                                              from:nil","                                                          delegate:myDelegate","                                                         onDismiss:nil];"]},{"anchor":"Configuring-the-Customer-Center","text":"Configuring the Customer Center","type":"heading","level":2},{"inlineContent":[{"text":"Set the default configuration via ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true},{"type":"text","text":" before calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"Superwall.configure(apiKey:purchaseController:options:completion:)"},{"type":"text","text":", or pass a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration","isActive":true},{"type":"text","text":" directly to a presentation call to override it for that"},{"type":"text","text":" "},{"type":"text","text":"presentation only."}],"type":"paragraph"},{"syntax":"swift","code":["let options = SuperwallOptions()","","let cancelSurvey = CustomerCenterConfiguration.FeedbackSurvey(","  id: \"cancel_survey\",","  title: \"Why are you cancelling?\",","  options: [","    .tooExpensive,","    .init(id: \"dont_use\", title: \"Don't use it enough\"),","    .boughtByMistake","  ]",")","","options.customerCenter = CustomerCenterConfiguration(","  managementScreen: .init(","    paths: [","      .restore,","      .changePlan,","      .refund,","      .manageSubscription(survey: cancelSurvey),","      .url(URL(string: \"https:\/\/mycompany.com\/faq\")!, title: \"FAQ\"),","      .contactSupport","    ]","  ),","  noPurchasesScreen: .init(","    paths: [.restore]","  ),","  support: .init(email: \"support@mycompany.com\")",")","","Superwall.configure(apiKey: \"MY_API_KEY\", options: options)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every path is optional and reorderable. Built-in path types ("},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"cover restoring purchases, managing or cancelling a subscription, requesting a refund, changing"},{"type":"text","text":" "},{"type":"text","text":"plans, and contacting support; "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/url(_:openMethod:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"opens a URL either in-app or externally, and "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"lets you handle an action entirely yourself via the delegate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every path type but "},{"type":"codeVoice","code":"url"},{"type":"text","text":" names its own row, so "},{"type":"codeVoice","code":"title"},{"type":"text","text":" on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"optional and overrides that default. A "},{"type":"codeVoice","code":"url"},{"text":" row needs a title, and ","type":"text"},{"type":"codeVoice","code":".url(_:title:)"},{"text":" asks for one:","type":"text"},{"text":" ","type":"text"},{"text":"a URL could be anything, and its host is the same across all of your own links, so deriving one","type":"text"},{"text":" ","type":"text"},{"text":"would render your FAQ, terms and privacy rows identically.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the survey, "},{"type":"codeVoice","code":".cancellation"},{"type":"text","text":" is the built-in one the default configuration uses:"},{"type":"text","text":" "},{"type":"codeVoice","code":".manageSubscription(survey: .cancellation)"},{"type":"text","text":". A survey’s options can mix the localized built-ins"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".tooExpensive"},{"type":"text","text":", "},{"type":"codeVoice","code":".dontUse"},{"type":"text","text":", "},{"type":"codeVoice","code":".boughtByMistake"},{"type":"text","text":") with your own. A survey without a "},{"type":"codeVoice","code":"title"},{"type":"text","text":" asks"},{"type":"text","text":" "},{"type":"text","text":"“Why are you cancelling?” on a manage-subscription path, so give it a title anywhere else."}]},{"type":"paragraph","inlineContent":[{"text":"Each path also has an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":", reported as ","type":"text"},{"type":"codeVoice","code":"path_id"},{"text":" on Customer Center events. You don’t need to set","type":"text"},{"text":" ","type":"text"},{"text":"it: a built-in path uses its type (","type":"text"},{"type":"codeVoice","code":"restore"},{"type":"text","text":", "},{"type":"codeVoice","code":"refund"},{"type":"text","text":", "},{"type":"codeVoice","code":"manage_subscription"},{"type":"text","text":" and so on), a "},{"type":"codeVoice","code":"url"},{"type":"text","text":" "},{"type":"text","text":"path uses its host and path ("},{"type":"codeVoice","code":"mycompany.com\/faq"},{"type":"text","text":") and a "},{"type":"codeVoice","code":"custom"},{"type":"text","text":" path uses its identifier. Pass your own "},{"type":"codeVoice","code":"id"},{"type":"text","text":" only when two paths"},{"type":"text","text":" "},{"type":"text","text":"on the same screen would otherwise share one, such as two "},{"type":"codeVoice","code":"refund"},{"type":"text","text":" paths with different windows."}]},{"level":3,"anchor":"Warning-customers-about-old-versions","type":"heading","text":"Warning customers about old versions"},{"inlineContent":[{"type":"text","text":"The Customer Center can show a banner asking the customer to update. By default it finds the"},{"type":"text","text":" "},{"type":"text","text":"published version itself, by looking your app up on the App Store:"}],"type":"paragraph"},{"code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  warnsAboutUpdates: true          \/\/ on by default",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Set "},{"code":"latestAppVersion","type":"codeVoice"},{"type":"text","text":" to skip the lookup and warn against a version you control, which is what"},{"type":"text","text":" "},{"type":"text","text":"you want if you gate support on a specific build:"}],"type":"paragraph"},{"code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  latestAppVersion: \"2.1.0\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The banner appears only when the installed version is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"older","type":"text"}]},{"text":" than the published one — never when","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"it merely differs. It is skipped entirely on TestFlight, sandbox and simulator builds, whose"},{"type":"text","text":" "},{"type":"text","text":"version is normally ahead of the App Store. Set "},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to stop the"},{"type":"text","text":" "},{"type":"text","text":"lookup without turning the banner off. Any failure — offline, no listing found, an unparseable"},{"type":"text","text":" "},{"type":"text","text":"version — hides the banner and logs under the "},{"type":"codeVoice","code":"customerCenter"},{"type":"text","text":" scope."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The lookup result is cached for 24 hours, and only the bundle identifier is sent. Because"},{"type":"text","text":" "},{"type":"text","text":"it happens after the screen has loaded, the banner animates in a moment later rather than being"},{"type":"text","text":" "},{"type":"text","text":"there on first paint."}]}],"name":"Note","type":"aside"},{"style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"Apple phases a release in over seven days, but the lookup sees the new version as soon","type":"text"},{"text":" ","type":"text"},{"text":"as it goes live. For the first few days of a release, some customers are told to update to a","type":"text"},{"text":" ","type":"text"},{"text":"build that hasn’t reached them yet. If that matters for your app, set ","type":"text"},{"type":"codeVoice","code":"latestAppVersion"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"raise it on your own schedule, or set ","type":"text"},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}]}],"name":"Warning","type":"aside"},{"text":"The Delegate","level":2,"anchor":"The-Delegate","type":"heading"},{"inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegate","isActive":true},{"type":"text","text":" (or "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegateObjc","isActive":true},{"type":"text","text":" from Objective-C) to"},{"type":"text","text":" "},{"type":"text","text":"observe and, where relevant, gate what happens in the Customer Center:"}],"type":"paragraph"},{"code":["final class MyCustomerCenterDelegate: CustomerCenterDelegate {","  func customerCenterShouldRestorePurchases() async -> Bool {","    true","  }","","  func customerCenterDidSelectAction(_ action: CustomerCenterAction, pathId: String, purchase: CustomerCenterPurchase?) {","    print(\"Customer Center path \\(pathId) selected: \\(action)\")","  }","","  func customerCenterDidCompleteSurvey(surveyId: String, optionId: String, action: CustomerCenterAction, pathId: String) {","    print(\"Survey \\(surveyId) answered with \\(optionId)\")","  }","","  func customerCenterDidCompleteRefundRequest(productId: String, status: CustomerCenterRefundStatus) {","    print(\"Refund request for \\(productId) finished with status \\(status)\")","  }","","  func customerCenterDidDismiss() {","    print(\"Customer Center dismissed\")","  }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The view controller does not retain its delegate — either keep a strong reference to it yourself,","type":"text"},{"text":" ","type":"text"},{"text":"or pass it to ","type":"text"},{"code":"presentCustomerCenter(delegate:)","type":"codeVoice"},{"text":", which retains it for the duration of the","type":"text"},{"text":" ","type":"text"},{"text":"presentation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In SwiftUI, use the equivalent modifiers instead of a delegate:","type":"text"}],"type":"paragraph"},{"code":["CustomerCenterView()","  .onCustomerCenterShouldRestore { true }","  .onCustomerCenterAction { action, pathId, purchase in print(action, pathId) }","  .onCustomerCenterSurveyResponse { surveyId, optionId, action, pathId in print(surveyId, optionId) }","  .onCustomerCenterRefundRequest { productId, status in print(productId, status) }","  .onCustomerCenterDismiss { print(\"dismissed\") }"],"type":"codeListing","syntax":"swift"},{"text":"Events","type":"heading","level":2,"anchor":"Events"},{"inlineContent":[{"type":"text","text":"The Customer Center fires the following "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallEvent","isActive":true},{"type":"text","text":" cases, which you can observe via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/handleSuperwallEvent(withInfo:)","isActive":true},{"type":"text","text":" alongside all other SDK events:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"customerCenterOpen"},{"type":"text","text":": the Customer Center is presented."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterClose","type":"codeVoice"},{"type":"text","text":": the Customer Center is dismissed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterAction"},{"type":"text","text":": the user taps a path."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterSurveyResponse","type":"codeVoice"},{"type":"text","text":": the user answers a survey attached to a path."}]}]},{"content":[{"inlineContent":[{"code":"customerCenterRefundRequest","type":"codeVoice"},{"text":": a refund request finishes.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Limitations","level":2,"text":"Limitations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Requires iOS 15.0+. On earlier versions, presentation calls are unavailable at compile time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A purchase whose product has no display name is headed by the entitlement it unlocks, or by","type":"text"},{"text":" ","type":"text"},{"text":"nothing — never by the product identifier. Today that is every web (Stripe, Paddle) purchase,","type":"text"},{"text":" ","type":"text"},{"text":"because the product catalogue doesn’t return a name yet; the name is used as soon as it does.","type":"text"},{"text":" ","type":"text"},{"text":"An App Store product has one once it is localized in App Store Connect — before that, StoreKit","type":"text"},{"text":" ","type":"text"},{"text":"reports an empty display name, which is treated the same way.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Promotional offers are not yet supported as a Customer Center path."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remote configuration of the Customer Center from the Superwall dashboard is coming; today it’s"},{"type":"text","text":" "},{"type":"text","text":"configured entirely in code via "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]}]}],"variants":[{"paths":["\/documentation\/superwallkit\/customercenter"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SuperwallKit"}],"role":"article","title":"Customer Center","roleHeading":"Article"},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SwiftUICore/View/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)":{"url":"\/documentation\/superwallkit\/swiftuicore\/view\/presentsuperwallcustomercenter(ispresented:configuration:ondismiss:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"presentSuperwallCustomerCenter"},{"kind":"text","text":"("},{"kind":"externalParam","text":"isPresented"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"text":"CustomerCenterConfiguration","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"onDismiss","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","role":"symbol","abstract":[{"text":"Presents the Customer Center as a sheet.","type":"text"}],"kind":"symbol","title":"presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","type":"topic"},"https://superwall.com":{"identifier":"https:\/\/superwall.com","titleInlineContent":[{"type":"text","text":"Superwall"}],"type":"link","url":"https:\/\/superwall.com","title":"Superwall"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/Path/url(_:title:openMethod:id:survey:)":{"abstract":[],"role":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path\/url(_:title:openMethod:id:survey:)","url":"\/documentation\/superwallkit\/customercenterconfiguration\/path\/url(_:title:openmethod:id:survey:)","type":"topic","kind":"symbol","title":"url(_:title:openMethod:id:survey:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"url"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:10Foundation3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"title"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"openMethod"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration","text":"CustomerCenterConfiguration","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit27CustomerCenterConfigurationC10OpenMethodO","text":"OpenMethod","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"survey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration","text":"CustomerCenterConfiguration","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit27CustomerCenterConfigurationC14FeedbackSurveyC","text":"FeedbackSurvey","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration","text":"CustomerCenterConfiguration","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit27CustomerCenterConfigurationC4PathC","text":"Path","kind":"typeIdentifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType/custom(identifier:)":{"abstract":[],"url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype\/custom(identifier:)","title":"CustomerCenterConfiguration.PathType.custom(identifier:)","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(i