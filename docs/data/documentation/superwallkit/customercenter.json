{"metadata":{"role":"article","roleHeading":"Article","title":"Customer Center","modules":[{"name":"SuperwallKit"}]},"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenter","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Customer Center lets users restore purchases, manage or cancel a subscription, request a","type":"text"},{"text":" ","type":"text"},{"text":"refund, change plans, contact support, answer exit surveys and open any subscription for its details — all","type":"text"},{"text":" ","type":"text"},{"text":"without leaving your app. It ships with sensible defaults and is fully configurable, so you can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"tailor which paths appear, their titles, surveys and accent colour to match your app."}]},{"inlineContent":[{"text":"The Customer Center requires ","type":"text"},{"inlineContent":[{"type":"text","text":"iOS 15.0+"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Presenting-from-UIKit","text":"Presenting from UIKit","level":3,"type":"heading"},{"inlineContent":[{"text":"Present it over your current view controller with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Superwall.shared.presentCustomerCenter()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController","type":"reference","isActive":true},{"type":"text","text":" yourself. Present it modally:"}],"type":"paragraph"},{"code":["let customerCenter = CustomerCenterViewController(delegate: myDelegate)","present(customerCenter, animated: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or push it onto a navigation controller of your own, which is what you want when the Customer","type":"text"},{"text":" ","type":"text"},{"text":"Center is a row in your own settings screen:","type":"text"}],"type":"paragraph"},{"code":["let customerCenter = CustomerCenterViewController(","  presentationStyle: .embedded,","  delegate: myDelegate",")","navigationController?.pushViewController(customerCenter, animated: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"An embedded Customer Center renders into your navigation bar and leaves it alone — your title, your"},{"type":"text","text":" "},{"type":"text","text":"back button, your appearance, your swipe-to-go-back. It adds no close button, since your stack"},{"type":"text","text":" "},{"type":"text","text":"already provides the way back. Its own screen — the detail for a subscription — is pushed onto"},{"type":"text","text":" "},{"type":"text","text":"your stack as a further view controller, so it behaves like any other screen you pushed yourself."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"CustomerCenterViewController"},{"text":" you construct yourself is yours, and the SDK does not","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"track it. "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","isActive":true},{"type":"text","text":" will present"},{"type":"text","text":" "},{"type":"text","text":"a second, independent Customer Center over the top of one you pushed, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/dismissCustomerCenter(completion:)","isActive":true},{"type":"text","text":" only dismisses the one the SDK presented — it"},{"type":"text","text":" "},{"type":"text","text":"does nothing to yours. Pick one entry point per screen: let the SDK present it, or own the"},{"type":"text","text":" "},{"type":"text","text":"lifecycle of the controller you construct."}]}],"type":"aside"},{"anchor":"Presenting-from-SwiftUI","level":3,"type":"heading","text":"Presenting from SwiftUI"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)"},{"type":"text","text":" modifier to present it as a sheet:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","  @State private var showsCustomerCenter = false","","  var body: some View {","    Button(\"Manage Subscription\") {","      showsCustomerCenter = true","    }","    .presentSuperwallCustomerCenter(isPresented: $showsCustomerCenter)","  }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Or embed ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","type":"reference"},{"text":" directly in your own navigation stack:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["CustomerCenterView(navigationOptions: .init(style: .embedded))"],"type":"codeListing"},{"anchor":"Presenting-from-Objective-C","level":3,"type":"heading","text":"Presenting from Objective-C"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"presentCustomerCenterWithConfiguration:from:delegate:onDismiss:","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"objc","code":["[Superwall.sharedInstance presentCustomerCenterWithConfiguration:nil","                                                              from:nil","                                                          delegate:myDelegate","                                                         onDismiss:nil];"],"type":"codeListing"},{"anchor":"Configuring-the-Customer-Center","level":2,"type":"heading","text":"Configuring the Customer Center"},{"inlineContent":[{"type":"text","text":"Set the default configuration via "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true},{"type":"text","text":" before calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"Superwall.configure(apiKey:purchaseController:options:completion:)"},{"text":", or pass a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration"},{"text":" directly to a presentation call to override it for that","type":"text"},{"text":" ","type":"text"},{"text":"presentation only.","type":"text"}],"type":"paragraph"},{"code":["let options = SuperwallOptions()","","let cancelSurvey = CustomerCenterConfiguration.FeedbackSurvey(","  id: \"cancel_survey\",","  title: \"Why are you cancelling?\",","  options: [","    .tooExpensive,","    .init(id: \"dont_use\", title: \"Don't use it enough\"),","    .boughtByMistake","  ]",")","","options.customerCenter = CustomerCenterConfiguration(","  managementScreen: .init(","    paths: [","      .restore,","      .changePlan,","      .refund,","      .manageSubscription(survey: cancelSurvey),","      .url(URL(string: \"https:\/\/mycompany.com\/faq\")!, title: \"FAQ\"),","      .contactSupport","    ]","  ),","  noPurchasesScreen: .init(","    paths: [.restore]","  ),","  support: .init(email: \"support@mycompany.com\")",")","","Superwall.configure(apiKey: \"MY_API_KEY\", options: options)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every path is optional and reorderable. Built-in path types ("},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"cover restoring purchases, managing or cancelling a subscription, requesting a refund, changing"},{"type":"text","text":" "},{"type":"text","text":"plans, and contacting support; "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/url(_:openMethod:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"opens a URL either in-app or externally, and "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"lets you handle an action entirely yourself via the delegate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every path type but "},{"code":"url","type":"codeVoice"},{"type":"text","text":" names its own row, so "},{"code":"title","type":"codeVoice"},{"type":"text","text":" on "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path","isActive":true,"type":"reference"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"optional and overrides that default. A "},{"code":"url","type":"codeVoice"},{"type":"text","text":" row needs a title, and "},{"code":".url(_:title:)","type":"codeVoice"},{"type":"text","text":" asks for one:"},{"type":"text","text":" "},{"text":"a URL could be anything, and its host is the same across all of your own links, so deriving one","type":"text"},{"text":" ","type":"text"},{"text":"would render your FAQ, terms and privacy rows identically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the survey, "},{"type":"codeVoice","code":".cancellation"},{"type":"text","text":" is the built-in one the default configuration uses:"},{"type":"text","text":" "},{"type":"codeVoice","code":".manageSubscription(survey: .cancellation)"},{"type":"text","text":". A survey’s options can mix the localized built-ins"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".tooExpensive"},{"type":"text","text":", "},{"type":"codeVoice","code":".dontUse"},{"type":"text","text":", "},{"type":"codeVoice","code":".boughtByMistake"},{"type":"text","text":") with your own. A survey without a "},{"type":"codeVoice","code":"title"},{"type":"text","text":" asks"},{"type":"text","text":" "},{"type":"text","text":"“Why are you cancelling?” on a manage-subscription path, so give it a title anywhere else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each path also has an "},{"type":"codeVoice","code":"id"},{"type":"text","text":", reported as "},{"type":"codeVoice","code":"path_id"},{"type":"text","text":" on Customer Center events. You don’t need to set"},{"type":"text","text":" "},{"type":"text","text":"it: a built-in path uses its type ("},{"type":"codeVoice","code":"restore"},{"type":"text","text":", "},{"type":"codeVoice","code":"refund"},{"type":"text","text":", "},{"code":"manage_subscription","type":"codeVoice"},{"type":"text","text":" and so on), a "},{"type":"codeVoice","code":"url"},{"text":" ","type":"text"},{"text":"path uses its host and path (","type":"text"},{"type":"codeVoice","code":"mycompany.com\/faq"},{"text":") and a ","type":"text"},{"type":"codeVoice","code":"custom"},{"text":" path uses its identifier. Pass your own ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" only when two paths","type":"text"},{"text":" ","type":"text"},{"text":"on the same screen would otherwise share one, such as two ","type":"text"},{"type":"codeVoice","code":"refund"},{"text":" paths with different windows.","type":"text"}]},{"anchor":"Warning-customers-about-old-versions","level":3,"text":"Warning customers about old versions","type":"heading"},{"inlineContent":[{"type":"text","text":"The Customer Center can show a banner asking the customer to update. By default it finds the"},{"type":"text","text":" "},{"type":"text","text":"published version itself, by looking your app up on the App Store:"}],"type":"paragraph"},{"code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  warnsAboutUpdates: true          \/\/ on by default",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Set ","type":"text"},{"code":"latestAppVersion","type":"codeVoice"},{"text":" to skip the lookup and warn against a version you control, which is what","type":"text"},{"text":" ","type":"text"},{"text":"you want if you gate support on a specific build:","type":"text"}],"type":"paragraph"},{"code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  latestAppVersion: \"2.1.0\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The banner appears only when the installed version is ","type":"text"},{"inlineContent":[{"text":"older","type":"text"}],"type":"emphasis"},{"text":" than the published one — never when","type":"text"},{"text":" ","type":"text"},{"text":"it merely differs. It is skipped entirely on TestFlight, sandbox and simulator builds, whose","type":"text"},{"text":" ","type":"text"},{"text":"version is normally ahead of the App Store. Set ","type":"text"},{"code":"checksAppStoreForUpdates","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to stop the"},{"type":"text","text":" "},{"type":"text","text":"lookup without turning the banner off. Any failure — offline, no listing found, an unparseable"},{"type":"text","text":" "},{"type":"text","text":"version — hides the banner and logs under the "},{"type":"codeVoice","code":"customerCenter"},{"type":"text","text":" scope."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The lookup result is cached for 24 hours, and only the bundle identifier is sent. Because"},{"type":"text","text":" "},{"type":"text","text":"it happens after the screen has loaded, the banner animates in a moment later rather than being"},{"type":"text","text":" "},{"type":"text","text":"there on first paint."}]}],"style":"note","type":"aside","name":"Note"},{"content":[{"inlineContent":[{"text":"Apple phases a release in over seven days, but the lookup sees the new version as soon","type":"text"},{"text":" ","type":"text"},{"text":"as it goes live. For the first few days of a release, some customers are told to update to a","type":"text"},{"text":" ","type":"text"},{"text":"build that hasn’t reached them yet. If that matters for your app, set ","type":"text"},{"code":"latestAppVersion","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"raise it on your own schedule, or set ","type":"text"},{"code":"checksAppStoreForUpdates","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"warning","type":"aside","name":"Warning"},{"level":2,"text":"The Delegate","type":"heading","anchor":"The-Delegate"},{"inlineContent":[{"text":"Implement ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegate","isActive":true},{"text":" (or ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegateObjc","type":"reference","isActive":true},{"text":" from Objective-C) to","type":"text"},{"text":" ","type":"text"},{"text":"observe and, where relevant, gate what happens in the Customer Center:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["final class MyCustomerCenterDelegate: CustomerCenterDelegate {","  func customerCenterShouldRestorePurchases() async -> Bool {","    true","  }","","  func customerCenterDidSelectAction(_ action: CustomerCenterAction, pathId: String, purchase: CustomerCenterPurchase?) {","    print(\"Customer Center path \\(pathId) selected: \\(action)\")","  }","","  func customerCenterDidCompleteSurvey(surveyId: String, optionId: String, action: CustomerCenterAction, pathId: String) {","    print(\"Survey \\(surveyId) answered with \\(optionId)\")","  }","","  func customerCenterDidCompleteRefundRequest(productId: String, status: CustomerCenterRefundStatus) {","    print(\"Refund request for \\(productId) finished with status \\(status)\")","  }","","  func customerCenterDidDismiss() {","    print(\"Customer Center dismissed\")","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view controller does not retain its delegate — either keep a strong reference to it yourself,"},{"type":"text","text":" "},{"type":"text","text":"or pass it to "},{"type":"codeVoice","code":"presentCustomerCenter(delegate:)"},{"type":"text","text":", which retains it for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"presentation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SwiftUI, use the equivalent modifiers instead of a delegate:"}]},{"type":"codeListing","syntax":"swift","code":["CustomerCenterView()","  .onCustomerCenterShouldRestore { true }","  .onCustomerCenterAction { action, pathId, purchase in print(action, pathId) }","  .onCustomerCenterSurveyResponse { surveyId, optionId, action, pathId in print(surveyId, optionId) }","  .onCustomerCenterRefundRequest { productId, status in print(productId, status) }","  .onCustomerCenterDismiss { print(\"dismissed\") }"]},{"type":"heading","text":"Events","anchor":"Events","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Customer Center fires the following "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallEvent"},{"type":"text","text":" cases, which you can observe via"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/handleSuperwallEvent(withInfo:)"},{"type":"text","text":" alongside all other SDK events:"}]},{"items":[{"content":[{"inlineContent":[{"code":"customerCenterOpen","type":"codeVoice"},{"text":": the Customer Center is presented.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterClose","type":"codeVoice"},{"text":": the Customer Center is dismissed.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"customerCenterAction","type":"codeVoice"},{"type":"text","text":": the user taps a path."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"customerCenterSurveyResponse","type":"codeVoice"},{"text":": the user answers a survey attached to a path.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"customerCenterRefundRequest"},{"type":"text","text":": a refund request finishes."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Limitations","type":"heading","level":2,"text":"Limitations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Requires iOS 15.0+. On earlier versions, presentation calls are unavailable at compile time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A purchase whose product has no display name is headed by the entitlement it unlocks, or by","type":"text"},{"text":" ","type":"text"},{"text":"nothing — never by the product identifier. Today that is every web (Stripe, Paddle) purchase,","type":"text"},{"text":" ","type":"text"},{"text":"because the product catalogue doesn’t return a name yet; the name is used as soon as it does.","type":"text"},{"text":" ","type":"text"},{"text":"An App Store product has one once it is localized in App Store Connect — before that, StoreKit","type":"text"},{"text":" ","type":"text"},{"text":"reports an empty display name, which is treated the same way.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Promotional offers are not yet supported as a Customer Center path."}]}]},{"content":[{"inlineContent":[{"text":"Remote configuration of the Customer Center from the Superwall dashboard is coming; today it’s","type":"text"},{"text":" ","type":"text"},{"text":"configured entirely in code via ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"abstract":[{"type":"text","text":"A native, self-service screen where users can view and manage their subscriptions and purchases."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/customercenter"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/customerCenter":{"kind":"symbol","url":"\/documentation\/superwallkit\/superwalloptions\/customercenter","abstract":[{"type":"text","text":"Configures the Customer Center presented via "},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","type":"reference"},{"type":"text","text":"."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerCenter"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration","kind":"typeIdentifier","text":"CustomerCenterConfiguration"}],"type":"topic","title":"customerCenter"},"https://superwall.com":{"titleInlineContent":[{"type":"text","text":"Superwall"}],"type":"link","url":"https:\/\/superwall.com","title":"Superwall","identifier":"https:\/\/superwall.com"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType/custom(identifier:)":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype\/custom(identifier:)","abstract":[],"title":"CustomerCenterConfiguration.PathType.custom(identifier:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"custom","kind":"identifier"},{"text":"(","kind":"text"},{"text":"identifier","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterViewController":{"abstract":[{"text":"A UIKit container for ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"CustomerCenterViewController","kind":"symbol","navigatorTitle":[{"text":"CustomerCenterViewController","kind":"identifier"}],"url":"\/documentation\/superwallkit\/customercenterviewcontroller","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerCenterViewController","kind":"identifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType":{"abstract":[{"text":"The kinds of path the Customer Center supports.","type":"text"}],"title":"CustomerCenterConfiguration.PathType","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PathType"}],"url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PathType"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SwiftUICore/View/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","kind":"symbol","abstract":[{"text":"Presents the Customer Center as a sheet.","type":"text"}],"role":"symbol","title":"presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","url":"\/documentation\/superwallkit\/swiftuicore\/view\/presentsuperwallcustomercenter(ispresented:configuration:ondismiss:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"presentSuperwallCustomerCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isPresented","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":">, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"te