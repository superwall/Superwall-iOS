{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/customercenter"]}],"abstract":[{"text":"A native, self-service screen where users can view and manage their subscriptions and purchases.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"metadata":{"role":"article","modules":[{"name":"SuperwallKit"}],"roleHeading":"Article","title":"Customer Center"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenter"},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Customer Center lets users restore purchases, manage or cancel a subscription, request a"},{"type":"text","text":" "},{"type":"text","text":"refund, change plans, contact support, answer exit surveys and open any subscription for its details — all"},{"type":"text","text":" "},{"type":"text","text":"without leaving your app. It ships with sensible defaults and is fully configurable, so you can"},{"type":"text","text":" "},{"type":"text","text":"tailor which paths appear, their titles, surveys and accent colour to match your app."}]},{"type":"paragraph","inlineContent":[{"text":"The Customer Center requires ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"iOS 15.0+"}]},{"text":".","type":"text"}]},{"text":"Presenting from UIKit","type":"heading","anchor":"Presenting-from-UIKit","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Present it over your current view controller with "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["Superwall.shared.presentCustomerCenter()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController","type":"reference","isActive":true},{"type":"text","text":" yourself. Present it modally:"}]},{"type":"codeListing","syntax":"swift","code":["let customerCenter = CustomerCenterViewController(delegate: myDelegate)","present(customerCenter, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"Or push it onto a navigation controller of your own, which is what you want when the Customer","type":"text"},{"text":" ","type":"text"},{"text":"Center is a row in your own settings screen:","type":"text"}]},{"syntax":"swift","code":["let customerCenter = CustomerCenterViewController(","  presentationStyle: .embedded,","  delegate: myDelegate",")","navigationController?.pushViewController(customerCenter, animated: true)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An embedded Customer Center renders into your navigation bar and leaves it alone — your title, your"},{"type":"text","text":" "},{"type":"text","text":"back button, your appearance, your swipe-to-go-back. It adds no close button, since your stack"},{"type":"text","text":" "},{"type":"text","text":"already provides the way back. Its own screen — the detail for a subscription — is pushed onto"},{"type":"text","text":" "},{"type":"text","text":"your stack as a further view controller, so it behaves like any other screen you pushed yourself."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"CustomerCenterViewController","type":"codeVoice"},{"type":"text","text":" you construct yourself is yours, and the SDK does not"},{"type":"text","text":" "},{"type":"text","text":"track it. "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","type":"reference","isActive":true},{"type":"text","text":" will present"},{"type":"text","text":" "},{"type":"text","text":"a second, independent Customer Center over the top of one you pushed, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/dismissCustomerCenter(completion:)","type":"reference","isActive":true},{"type":"text","text":" only dismisses the one the SDK presented — it"},{"type":"text","text":" "},{"type":"text","text":"does nothing to yours. Pick one entry point per screen: let the SDK present it, or own the"},{"type":"text","text":" "},{"type":"text","text":"lifecycle of the controller you construct."}]}],"name":"Important","type":"aside","style":"important"},{"level":3,"type":"heading","anchor":"Presenting-from-SwiftUI","text":"Presenting from SwiftUI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","isActive":true},{"type":"text","text":" modifier to present it as a sheet:"}]},{"syntax":"swift","code":["struct SettingsView: View {","  @State private var showsCustomerCenter = false","","  var body: some View {","    Button(\"Manage Subscription\") {","      showsCustomerCenter = true","    }","    .presentSuperwallCustomerCenter(isPresented: $showsCustomerCenter)","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or embed "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","isActive":true,"type":"reference"},{"text":" directly in your own navigation stack:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["CustomerCenterView(navigationOptions: .init(style: .embedded))"]},{"type":"heading","anchor":"Presenting-from-Objective-C","level":3,"text":"Presenting from Objective-C"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"presentCustomerCenterWithConfiguration:from:delegate:onDismiss:","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"objc","code":["[Superwall.sharedInstance presentCustomerCenterWithConfiguration:nil","                                                              from:nil","                                                          delegate:myDelegate","                                                         onDismiss:nil];"]},{"type":"heading","anchor":"Configuring-the-Customer-Center","level":2,"text":"Configuring the Customer Center"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the default configuration via "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true},{"type":"text","text":" before calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"Superwall.configure(apiKey:purchaseController:options:completion:)"},{"type":"text","text":", or pass a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration","isActive":true},{"type":"text","text":" directly to a presentation call to override it for that"},{"type":"text","text":" "},{"type":"text","text":"presentation only."}]},{"type":"codeListing","syntax":"swift","code":["let options = SuperwallOptions()","","let cancelSurvey = CustomerCenterConfiguration.FeedbackSurvey(","  id: \"cancel_survey\",","  title: \"Why are you cancelling?\",","  options: [","    .tooExpensive,","    .init(id: \"dont_use\", title: \"Don't use it enough\"),","    .boughtByMistake","  ]",")","","options.customerCenter = CustomerCenterConfiguration(","  managementScreen: .init(","    paths: [","      .restore,","      .changePlan,","      .refund,","      .manageSubscription(survey: cancelSurvey),","      .url(URL(string: \"https:\/\/mycompany.com\/faq\")!, title: \"FAQ\"),","      .contactSupport","    ]","  ),","  noPurchasesScreen: .init(","    paths: [.restore]","  ),","  support: .init(email: \"support@mycompany.com\")",")","","Superwall.configure(apiKey: \"MY_API_KEY\", options: options)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every path is optional and reorderable. Built-in path types ("},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"cover restoring purchases, managing or cancelling a subscription, requesting a refund, changing"},{"type":"text","text":" "},{"type":"text","text":"plans, and contacting support; "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/url(_:openMethod:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"opens a URL either in-app or externally, and "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"lets you handle an action entirely yourself via the delegate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every path type but "},{"type":"codeVoice","code":"url"},{"type":"text","text":" names its own row, so "},{"type":"codeVoice","code":"title"},{"type":"text","text":" on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"optional and overrides that default. A "},{"type":"codeVoice","code":"url"},{"type":"text","text":" row needs a title, and "},{"type":"codeVoice","code":".url(_:title:)"},{"type":"text","text":" asks for one:"},{"type":"text","text":" "},{"type":"text","text":"a URL could be anything, and its host is the same across all of your own links, so deriving one"},{"type":"text","text":" "},{"type":"text","text":"would render your FAQ, terms and privacy rows identically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the survey, "},{"type":"codeVoice","code":".cancellation"},{"type":"text","text":" is the built-in one the default configuration uses:"},{"type":"text","text":" "},{"type":"codeVoice","code":".manageSubscription(survey: .cancellation)"},{"type":"text","text":". A survey’s options can mix the localized built-ins"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".tooExpensive"},{"type":"text","text":", "},{"type":"codeVoice","code":".dontUse"},{"type":"text","text":", "},{"type":"codeVoice","code":".boughtByMistake"},{"type":"text","text":") with your own. A survey without a "},{"type":"codeVoice","code":"title"},{"type":"text","text":" asks"},{"type":"text","text":" "},{"type":"text","text":"“Why are you cancelling?” on a manage-subscription path, so give it a title anywhere else."}]},{"inlineContent":[{"text":"Each path also has an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":", reported as ","type":"text"},{"code":"path_id","type":"codeVoice"},{"text":" on Customer Center events. You don’t need to set","type":"text"},{"text":" ","type":"text"},{"text":"it: a built-in path uses its type (","type":"text"},{"code":"restore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"refund","type":"codeVoice"},{"text":", ","type":"text"},{"code":"manage_subscription","type":"codeVoice"},{"text":" and so on), a ","type":"text"},{"code":"url","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path uses its host and path (","type":"text"},{"code":"mycompany.com\/faq","type":"codeVoice"},{"text":") and a ","type":"text"},{"code":"custom","type":"codeVoice"},{"text":" path uses its identifier. Pass your own ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" only when two paths","type":"text"},{"text":" ","type":"text"},{"text":"on the same screen would otherwise share one, such as two ","type":"text"},{"code":"refund","type":"codeVoice"},{"text":" paths with different windows.","type":"text"}],"type":"paragraph"},{"anchor":"Warning-customers-about-old-versions","level":3,"text":"Warning customers about old versions","type":"heading"},{"inlineContent":[{"text":"The Customer Center can show a banner asking the customer to update. By default it finds the","type":"text"},{"text":" ","type":"text"},{"text":"published version itself, by looking your app up on the App Store:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  warnsAboutUpdates: true          \/\/ on by default",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"latestAppVersion"},{"type":"text","text":" to skip the lookup and warn against a version you control, which is what"},{"type":"text","text":" "},{"type":"text","text":"you want if you gate support on a specific build:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  latestAppVersion: \"2.1.0\"",")"]},{"inlineContent":[{"text":"The banner appears only when the installed version is ","type":"text"},{"inlineContent":[{"type":"text","text":"older"}],"type":"emphasis"},{"text":" than the published one — never when","type":"text"},{"text":" ","type":"text"},{"text":"it merely differs. It is skipped entirely on TestFlight, sandbox and simulator builds, whose","type":"text"},{"text":" ","type":"text"},{"text":"version is normally ahead of the App Store. Set ","type":"text"},{"code":"checksAppStoreForUpdates","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" to stop the","type":"text"},{"text":" ","type":"text"},{"text":"lookup without turning the banner off. Any failure — offline, no listing found, an unparseable","type":"text"},{"text":" ","type":"text"},{"text":"version — hides the banner and logs under the ","type":"text"},{"code":"customerCenter","type":"codeVoice"},{"text":" scope.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"The lookup result is cached for 24 hours, and only the bundle identifier is sent. Because","type":"text"},{"text":" ","type":"text"},{"text":"it happens after the screen has loaded, the banner animates in a moment later rather than being","type":"text"},{"text":" ","type":"text"},{"text":"there on first paint.","type":"text"}],"type":"paragraph"}]},{"style":"warning","type":"aside","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"Apple phases a release in over seven days, but the lookup sees the new version as soon"},{"type":"text","text":" "},{"type":"text","text":"as it goes live. For the first few days of a release, some customers are told to update to a"},{"type":"text","text":" "},{"type":"text","text":"build that hasn’t reached them yet. If that matters for your app, set "},{"type":"codeVoice","code":"latestAppVersion"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"raise it on your own schedule, or set "},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"heading","text":"The Delegate","level":2,"anchor":"The-Delegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegate"},{"type":"text","text":" (or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegateObjc"},{"type":"text","text":" from Objective-C) to"},{"type":"text","text":" "},{"type":"text","text":"observe and, where relevant, gate what happens in the Customer Center:"}]},{"type":"codeListing","code":["final class MyCustomerCenterDelegate: CustomerCenterDelegate {","  func customerCenterShouldRestorePurchases() async -> Bool {","    true","  }","","  func customerCenterDidSelectAction(_ action: CustomerCenterAction, pathId: String, purchase: CustomerCenterPurchase?) {","    print(\"Customer Center path \\(pathId) selected: \\(action)\")","  }","","  func customerCenterDidCompleteSurvey(surveyId: String, optionId: String, action: CustomerCenterAction, pathId: String) {","    print(\"Survey \\(surveyId) answered with \\(optionId)\")","  }","","  func customerCenterDidCompleteRefundRequest(productId: String, status: CustomerCenterRefundStatus) {","    print(\"Refund request for \\(productId) finished with status \\(status)\")","  }","","  func customerCenterDidDismiss() {","    print(\"Customer Center dismissed\")","  }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The view controller does not retain its delegate — either keep a strong reference to it yourself,","type":"text"},{"text":" ","type":"text"},{"text":"or pass it to ","type":"text"},{"code":"presentCustomerCenter(delegate:)","type":"codeVoice"},{"text":", which retains it for the duration of the","type":"text"},{"text":" ","type":"text"},{"text":"presentation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SwiftUI, use the equivalent modifiers instead of a delegate:"}]},{"type":"codeListing","code":["CustomerCenterView()","  .onCustomerCenterShouldRestore { true }","  .onCustomerCenterAction { action, pathId, purchase in print(action, pathId) }","  .onCustomerCenterSurveyResponse { surveyId, optionId, action, pathId in print(surveyId, optionId) }","  .onCustomerCenterRefundRequest { productId, status in print(productId, status) }","  .onCustomerCenterDismiss { print(\"dismissed\") }"],"syntax":"swift"},{"type":"heading","text":"Events","level":2,"anchor":"Events"},{"type":"paragraph","inlineContent":[{"text":"The Customer Center fires the following ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallEvent","type":"reference","isActive":true},{"text":" cases, which you can observe via","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/handleSuperwallEvent(withInfo:)","type":"reference","isActive":true},{"text":" alongside all other SDK events:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterOpen","type":"codeVoice"},{"type":"text","text":": the Customer Center is presented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"customerCenterClose","type":"codeVoice"},{"text":": the Customer Center is dismissed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterAction"},{"type":"text","text":": the user taps a path."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"customerCenterSurveyResponse"},{"text":": the user answers a survey attached to a path.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"customerCenterRefundRequest","type":"codeVoice"},{"type":"text","text":": a refund request finishes."}],"type":"paragraph"}]}]},{"anchor":"Limitations","type":"heading","level":2,"text":"Limitations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Requires iOS 15.0+. On earlier versions, presentation calls are unavailable at compile time.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A purchase whose product has no display name is headed by the entitlement it unlocks, or by"},{"type":"text","text":" "},{"type":"text","text":"nothing — never by the product identifier. Today that is every web (Stripe, Paddle) purchase,"},{"type":"text","text":" "},{"type":"text","text":"because the product catalogue doesn’t return a name yet; the name is used as soon as it does."},{"type":"text","text":" "},{"type":"text","text":"An App Store product has one once it is localized in App Store Connect — before that, StoreKit"},{"type":"text","text":" "},{"type":"text","text":"reports an empty display name, which is treated the same way."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Promotional offers are not yet supported as a Customer Center path."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remote configuration of the Customer Center from the Superwall dashboard is coming; today it’s","type":"text"},{"text":" ","type":"text"},{"text":"configured entirely in code via ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","type":"reference","isActive":true},{"text":".","type":"text"}]}]}]}]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterDelegateObjc":{"type":"topic","navigatorTitle":[{"text":"CustomerCenterDelegateObjc","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Objective-C variant of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegate"},{"type":"text","text":"."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerCenterDelegateObjc","kind":"identifier"}],"title":"CustomerCenterDelegateObjc","url":"\/documentation\/superwallkit\/customercenterdelegateobjc","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegateObjc"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SwiftUICore/View/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)":{"type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","title":"presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","abstract":[{"type":"text","text":"Presents the Customer Center as a sheet."}],"kind":"symbol","url":"\/documentation\/superwallkit\/swiftuicore\/view\/presentsuperwallcustomercenter(ispresented:configuration:ondismiss:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"presentSuperwallCustomerCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isPresented","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":">, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CustomerCenterConfiguration","kind":"typeIdentifier","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration"},{"text":"?, ","kind":"text"},{"text":"onDismiss","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallEvent":{"kind":"symbol","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallEvent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuperwallEvent","kind":"identifier"}],"abstract":[{"type":"text","text":"Analytical events that are automatically tracked by Superwall."}],"title":"SuperwallEvent","url":"\/documentation\/superwallkit\/superwallevent","role":"symbol","navigatorTitle":[{"text":"SuperwallEvent","kind":"identifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType":{"type":"topic","kind":"symbol","title":"CustomerCenterConfiguration.PathType","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","abstract":[{"text":"The kinds of path the Customer Center supports.","type":"text"}],"url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PathType","kind":"identifier"}],"navigatorTitle":[{"text":"PathType","kind":"identifier"}],"role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/Path/url(_:title:openMethod:id:survey:)":{"role":"symbol","kind":"symbol","url":"\/documentation\/superwallkit\/customercenterconfiguration\/path\/url(_:title:openmethod:id:survey:)","abstract":[],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"url"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:10Foundation3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"title"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"openMethod"},{"kind"