{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/superwallkit\/customercenter"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","title":"Customer Center","roleHeading":"Article","modules":[{"name":"SuperwallKit"}]},"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenter","interfaceLanguage":"swift"},"abstract":[{"text":"A native, self-service screen where users can view and manage their subscriptions and purchases.","type":"text"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The Customer Center lets users restore purchases, manage or cancel a subscription, request a","type":"text"},{"text":" ","type":"text"},{"text":"refund, change plans, contact support, answer exit surveys and open any subscription for its details — all","type":"text"},{"text":" ","type":"text"},{"text":"without leaving your app. It ships with sensible defaults and is fully configurable, so you can","type":"text"},{"text":" ","type":"text"},{"text":"tailor which paths appear, their titles, surveys and accent colour to match your app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Customer Center requires ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"iOS 15.0+"}]},{"text":".","type":"text"}]},{"text":"Presenting from UIKit","type":"heading","anchor":"Presenting-from-UIKit","level":3},{"type":"paragraph","inlineContent":[{"text":"Present it over your current view controller with ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Superwall.shared.presentCustomerCenter()"]},{"type":"paragraph","inlineContent":[{"text":"Or use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController","isActive":true,"type":"reference"},{"text":" yourself. Present it modally:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let customerCenter = CustomerCenterViewController(delegate: myDelegate)","present(customerCenter, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"Or push it onto a navigation controller of your own, which is what you want when the Customer","type":"text"},{"text":" ","type":"text"},{"text":"Center is a row in your own settings screen:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let customerCenter = CustomerCenterViewController(","  presentationStyle: .embedded,","  delegate: myDelegate",")","navigationController?.pushViewController(customerCenter, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"An embedded Customer Center renders into your navigation bar and leaves it alone — your title, your","type":"text"},{"text":" ","type":"text"},{"text":"back button, your appearance, your swipe-to-go-back. It adds no close button, since your stack","type":"text"},{"text":" ","type":"text"},{"text":"already provides the way back. Its own screen — the detail for a subscription — is pushed onto","type":"text"},{"text":" ","type":"text"},{"text":"your stack as a further view controller, so it behaves like any other screen you pushed yourself.","type":"text"}]},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"CustomerCenterViewController","type":"codeVoice"},{"type":"text","text":" you construct yourself is yours, and the SDK does not"},{"type":"text","text":" "},{"type":"text","text":"track it. "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/presentCustomerCenter(configuration:from:delegate:onDismiss:)","type":"reference","isActive":true},{"type":"text","text":" will present"},{"type":"text","text":" "},{"type":"text","text":"a second, independent Customer Center over the top of one you pushed, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/dismissCustomerCenter(completion:)","type":"reference","isActive":true},{"type":"text","text":" only dismisses the one the SDK presented — it"},{"type":"text","text":" "},{"type":"text","text":"does nothing to yours. Pick one entry point per screen: let the SDK present it, or own the"},{"type":"text","text":" "},{"type":"text","text":"lifecycle of the controller you construct."}]}],"name":"Important"},{"text":"Presenting from SwiftUI","type":"heading","anchor":"Presenting-from-SwiftUI","level":3},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","isActive":true,"type":"reference"},{"text":" modifier to present it as a sheet:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsView: View {","  @State private var showsCustomerCenter = false","","  var body: some View {","    Button(\"Manage Subscription\") {","      showsCustomerCenter = true","    }","    .presentSuperwallCustomerCenter(isPresented: $showsCustomerCenter)","  }","}"]},{"type":"paragraph","inlineContent":[{"text":"Or embed ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","isActive":true,"type":"reference"},{"text":" directly in your own navigation stack:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["CustomerCenterView(navigationOptions: .init(style: .embedded))"]},{"text":"Presenting from Objective-C","type":"heading","anchor":"Presenting-from-Objective-C","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"presentCustomerCenterWithConfiguration:from:delegate:onDismiss:"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"objc","code":["[Superwall.sharedInstance presentCustomerCenterWithConfiguration:nil","                                                              from:nil","                                                          delegate:myDelegate","                                                         onDismiss:nil];"]},{"text":"Configuring the Customer Center","type":"heading","anchor":"Configuring-the-Customer-Center","level":2},{"type":"paragraph","inlineContent":[{"text":"Set the default configuration via ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true,"type":"reference"},{"text":" before calling","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Superwall.configure(apiKey:purchaseController:options:completion:)"},{"text":", or pass a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration","isActive":true,"type":"reference"},{"text":" directly to a presentation call to override it for that","type":"text"},{"text":" ","type":"text"},{"text":"presentation only.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let options = SuperwallOptions()","","let cancelSurvey = CustomerCenterConfiguration.FeedbackSurvey(","  id: \"cancel_survey\",","  title: \"Why are you cancelling?\",","  options: [","    .tooExpensive,","    .init(id: \"dont_use\", title: \"Don't use it enough\"),","    .boughtByMistake","  ]",")","","options.customerCenter = CustomerCenterConfiguration(","  managementScreen: .init(","    paths: [","      .restore,","      .changePlan,","      .refund,","      .manageSubscription(survey: cancelSurvey),","      .url(URL(string: \"https:\/\/mycompany.com\/faq\")!, title: \"FAQ\"),","      .contactSupport","    ]","  ),","  noPurchasesScreen: .init(","    paths: [.restore]","  ),","  support: .init(email: \"support@mycompany.com\")",")","","Superwall.configure(apiKey: \"MY_API_KEY\", options: options)"]},{"type":"paragraph","inlineContent":[{"text":"Every path is optional and reorderable. Built-in path types (","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"cover restoring purchases, managing or cancelling a subscription, requesting a refund, changing","type":"text"},{"text":" ","type":"text"},{"text":"plans, and contacting support; ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/url(_:openMethod:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"opens a URL either in-app or externally, and ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType\/custom(identifier:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"lets you handle an action entirely yourself via the delegate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every path type but ","type":"text"},{"type":"codeVoice","code":"url"},{"text":" names its own row, so ","type":"text"},{"type":"codeVoice","code":"title"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path","isActive":true,"type":"reference"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"optional and overrides that default. A ","type":"text"},{"type":"codeVoice","code":"url"},{"text":" row needs a title, and ","type":"text"},{"type":"codeVoice","code":".url(_:title:)"},{"text":" asks for one:","type":"text"},{"text":" ","type":"text"},{"text":"a URL could be anything, and its host is the same across all of your own links, so deriving one","type":"text"},{"text":" ","type":"text"},{"text":"would render your FAQ, terms and privacy rows identically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the survey, "},{"type":"codeVoice","code":".cancellation"},{"type":"text","text":" is the built-in one the default configuration uses:"},{"type":"text","text":" "},{"type":"codeVoice","code":".manageSubscription(survey: .cancellation)"},{"type":"text","text":". A survey’s options can mix the localized built-ins"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".tooExpensive"},{"type":"text","text":", "},{"type":"codeVoice","code":".dontUse"},{"type":"text","text":", "},{"type":"codeVoice","code":".boughtByMistake"},{"type":"text","text":") with your own. A survey without a "},{"type":"codeVoice","code":"title"},{"type":"text","text":" asks"},{"type":"text","text":" "},{"type":"text","text":"“Why are you cancelling?” on a manage-subscription path, so give it a title anywhere else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each path also has an "},{"type":"codeVoice","code":"id"},{"type":"text","text":", reported as "},{"type":"codeVoice","code":"path_id"},{"type":"text","text":" on Customer Center events. You don’t need to set"},{"type":"text","text":" "},{"type":"text","text":"it: a built-in path uses its type ("},{"type":"codeVoice","code":"restore"},{"type":"text","text":", "},{"type":"codeVoice","code":"refund"},{"type":"text","text":", "},{"type":"codeVoice","code":"manage_subscription"},{"type":"text","text":" and so on), a "},{"type":"codeVoice","code":"url"},{"type":"text","text":" "},{"type":"text","text":"path uses its host and path ("},{"type":"codeVoice","code":"mycompany.com\/faq"},{"type":"text","text":") and a "},{"type":"codeVoice","code":"custom"},{"type":"text","text":" path uses its identifier. Pass your own "},{"type":"codeVoice","code":"id"},{"type":"text","text":" only when two paths"},{"type":"text","text":" "},{"type":"text","text":"on the same screen would otherwise share one, such as two "},{"type":"codeVoice","code":"refund"},{"type":"text","text":" paths with different windows."}]},{"type":"heading","level":3,"text":"Warning customers about old versions","anchor":"Warning-customers-about-old-versions"},{"inlineContent":[{"type":"text","text":"The Customer Center can show a banner asking the customer to update. By default it finds the"},{"type":"text","text":" "},{"text":"published version itself, by looking your app up on the App Store:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  warnsAboutUpdates: true          \/\/ on by default",")"]},{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"latestAppVersion"},{"type":"text","text":" to skip the lookup and warn against a version you control, which is what"},{"type":"text","text":" "},{"type":"text","text":"you want if you gate support on a specific build:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["options.customerCenter.support = .init(","  email: \"support@mycompany.com\",","  latestAppVersion: \"2.1.0\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The banner appears only when the installed version is "},{"inlineContent":[{"text":"older","type":"text"}],"type":"emphasis"},{"type":"text","text":" than the published one — never when"},{"type":"text","text":" "},{"type":"text","text":"it merely differs. It is skipped entirely on TestFlight, sandbox and simulator builds, whose"},{"type":"text","text":" "},{"type":"text","text":"version is normally ahead of the App Store. Set "},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to stop the"},{"type":"text","text":" "},{"type":"text","text":"lookup without turning the banner off. Any failure — offline, no listing found, an unparseable"},{"text":" ","type":"text"},{"text":"version — hides the banner and logs under the ","type":"text"},{"type":"codeVoice","code":"customerCenter"},{"text":" scope.","type":"text"}]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The lookup result is cached for 24 hours, and only the bundle identifier is sent. Because","type":"text"},{"text":" ","type":"text"},{"text":"it happens after the screen has loaded, the banner animates in a moment later rather than being","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"there on first paint."}]}],"type":"aside"},{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple phases a release in over seven days, but the lookup sees the new version as soon"},{"type":"text","text":" "},{"type":"text","text":"as it goes live. For the first few days of a release, some customers are told to update to a"},{"type":"text","text":" "},{"type":"text","text":"build that hasn’t reached them yet. If that matters for your app, set "},{"type":"codeVoice","code":"latestAppVersion"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"raise it on your own schedule, or set "},{"type":"codeVoice","code":"checksAppStoreForUpdates"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}],"type":"aside"},{"level":2,"text":"The Delegate","anchor":"The-Delegate","type":"heading"},{"inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegate","isActive":true},{"type":"text","text":" (or "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterDelegateObjc","isActive":true},{"type":"text","text":" from Objective-C) to"},{"type":"text","text":" "},{"type":"text","text":"observe and, where relevant, gate what happens in the Customer Center:"}],"type":"paragraph"},{"syntax":"swift","code":["final class MyCustomerCenterDelegate: CustomerCenterDelegate {","  func customerCenterShouldRestorePurchases() async -> Bool {","    true","  }","","  func customerCenterDidSelectAction(_ action: CustomerCenterAction, pathId: String, purchase: CustomerCenterPurchase?) {","    print(\"Customer Center path \\(pathId) selected: \\(action)\")","  }","","  func customerCenterDidCompleteSurvey(surveyId: String, optionId: String, action: CustomerCenterAction, pathId: String) {","    print(\"Survey \\(surveyId) answered with \\(optionId)\")","  }","","  func customerCenterDidCompleteRefundRequest(productId: String, status: CustomerCenterRefundStatus) {","    print(\"Refund request for \\(productId) finished with status \\(status)\")","  }","","  func customerCenterDidDismiss() {","    print(\"Customer Center dismissed\")","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The view controller does not retain its delegate — either keep a strong reference to it yourself,"},{"type":"text","text":" "},{"type":"text","text":"or pass it to "},{"type":"codeVoice","code":"presentCustomerCenter(delegate:)"},{"type":"text","text":", which retains it for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"presentation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In SwiftUI, use the equivalent modifiers instead of a delegate:"}],"type":"paragraph"},{"syntax":"swift","code":["CustomerCenterView()","  .onCustomerCenterShouldRestore { true }","  .onCustomerCenterAction { action, pathId, purchase in print(action, pathId) }","  .onCustomerCenterSurveyResponse { surveyId, optionId, action, pathId in print(surveyId, optionId) }","  .onCustomerCenterRefundRequest { productId, status in print(productId, status) }","  .onCustomerCenterDismiss { print(\"dismissed\") }"],"type":"codeListing"},{"level":2,"text":"Events","anchor":"Events","type":"heading"},{"inlineContent":[{"type":"text","text":"The Customer Center fires the following "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallEvent","isActive":true},{"type":"text","text":" cases, which you can observe via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/handleSuperwallEvent(withInfo:)","isActive":true},{"type":"text","text":" alongside all other SDK events:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterOpen"},{"type":"text","text":": the Customer Center is presented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterClose"},{"type":"text","text":": the Customer Center is dismissed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterAction"},{"type":"text","text":": the user taps a path."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterSurveyResponse"},{"type":"text","text":": the user answers a survey attached to a path."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"customerCenterRefundRequest"},{"type":"text","text":": a refund request finishes."}]}]}],"type":"unorderedList"},{"level":2,"text":"Limitations","anchor":"Limitations","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Requires iOS 15.0+. On earlier versions, presentation calls are unavailable at compile time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A purchase whose product has no display name is headed by the entitlement it unlocks, or by"},{"type":"text","text":" "},{"type":"text","text":"nothing — never by the product identifier. Today that is every web (Stripe, Paddle) purchase,"},{"type":"text","text":" "},{"type":"text","text":"because the product catalogue doesn’t return a name yet; the name is used as soon as it does."},{"type":"text","text":" "},{"type":"text","text":"An App Store product has one once it is localized in App Store Connect — before that, StoreKit"},{"type":"text","text":" "},{"type":"text","text":"reports an empty display name, which is treated the same way."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Promotional offers are not yet supported as a Customer Center path."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remote configuration of the Customer Center from the Superwall dashboard is coming; today it’s"},{"type":"text","text":" "},{"type":"text","text":"configured entirely in code via "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/customerCenter","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/Path":{"url":"\/documentation\/superwallkit\/customercenterconfiguration\/path","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Path","kind":"identifier"}],"title":"CustomerCenterConfiguration.Path","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Path"}],"type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/Path","abstract":[{"text":"An action row in the Customer Center.","type":"text"}]},"https://superwall.com":{"type":"link","identifier":"https:\/\/superwall.com","title":"Superwall","url":"https:\/\/superwall.com","titleInlineContent":[{"text":"Superwall","type":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterConfiguration/PathType":{"navigatorTitle":[{"text":"PathType","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PathType","kind":"identifier"}],"url":"\/documentation\/superwallkit\/customercenterconfiguration\/pathtype","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterConfiguration\/PathType","abstract":[{"type":"text","text":"The kinds of path the Customer Center supports."}],"title":"CustomerCenterConfiguration.PathType","role":"symbol","type":"topic","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/CustomerCenterViewController":{"url":"\/documentation\/superwallkit\/customercenterviewcontroller","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerCenterViewController","kind":"identifier"}],"title":"CustomerCenterViewController","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"CustomerCenterViewController","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterViewController","abstract":[{"text":"A UIKit container for ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/CustomerCenterView","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SwiftUICore/View/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"presentSuperwallCustomerCenter"},{"kind":"text","text":"("},{"kind":"externalParam","text":"isPresented"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CustomerCenterConfiguration","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKCustomerCenterConfiguration"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"onDismiss"},{"kind":"text","text":": (() -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"url":"\/documentation\/superwallkit\/swiftuicore\/view\/presentsuperwallcustomercenter(ispresented:configuration:ondismiss:)","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SwiftUICore\/View\/presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","abstract":[{"text":"Presents the Customer Center as a sheet.","type":"text"}],"title":"presentSuperwallCustomerCenter(isPresented:configuration:onDismiss:)","role":"symbol","type":"topic","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/Superwall/dismissCustomerCenter(completion:)":{"url":"\/documentation\/superwallkit\/superwall\/dismisscustomercenter(completion:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissCustomerCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"completion","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")?)","kind":"text"}],"title":"dismissCustomerCenter(completion:)","role":"symbo