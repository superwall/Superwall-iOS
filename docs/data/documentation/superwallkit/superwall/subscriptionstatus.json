","isActive":true,"type":"reference"},{"text":", they are merged into","type":"text"},{"text":" ","type":"text"},{"text":"every value you assign here. Assigning ","type":"text"},{"code":".inactive","type":"codeVoice"},{"text":" does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" remove","type":"text"},{"text":" ","type":"text"},{"text":"them — the status stays active for as long as ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"contains an active entitlement. To revoke them, set","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","type":"reference","isActive":true},{"text":" to an empty set.","type":"text"}],"type":"paragraph"}],"name":"Warning"}]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"title":"SuperwallKit","url":"\/documentation\/superwallkit","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","kind":"symbol","abstract":[],"type":"topic","role":"collection"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PublishedSubscriptionStatus":{"title":"PublishedSubscriptionStatus","kind":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PublishedSubscriptionStatus","role":"symbol","url":"\/documentation\/superwallkit\/publishedsubscriptionstatus","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PublishedSubscriptionStatus","kind":"identifier"}],"type":"topic","abstract":[{"text":"The property wrapper behind ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/subscriptionStatus","type":"reference"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"Pub