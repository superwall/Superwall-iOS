text":"a background one; when several threads change it at once, one of them"},{"type":"text","text":" "},{"type":"text","text":"delivers the others’ changes too, and a slow subscriber holds those up."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"receive(on:)"},{"text":" before updating UI, and don’t block in a subscriber.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise, you can check the delegate function"},{"type":"text","text":" "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/subscriptionStatusDidChange(from:to:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to receive a callback whenever the logical status changes."}]},{"style":"warning","name":"Warning","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"If you’ve set ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","type":"reference"},{"text":", they are merged into","type":"text"},{"text":" ","type":"text"},{"text":"every value you assign here. Assigning ","type":"text"},{"code":".inactive","type":"codeVoice"},{"text":" does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" remove","type":"text"},{"text":" ","type":"text"},{"text":"them — the status stays active for as long as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","type":"reference"},{"text":" ","type":"text"},{"text":"contains an active entitlement. To revoke them, set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","type":"reference"},{"text":" to an empty set.","type":"text"}]}]}],"kind":"content"}],"hi