{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/subscriptionStatus"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"PublishedSubscriptionStatus","kind":"attribute","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PublishedSubscriptionStatus","preciseIdentifier":"s:12SuperwallKit27PublishedSubscriptionStatusV"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subscriptionStatus","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SubscriptionStatus","kind":"typeIdentifier","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SubscriptionStatus","preciseIdentifier":"s:12SuperwallKit18SubscriptionStatusO"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re using Combine or SwiftUI, you can subscribe or bind to it to get"},{"type":"text","text":" "},{"type":"text","text":"notified whenever it changes. The publisher only ever emits the merged"},{"type":"text","text":" "},{"type":"text","text":"status – never a value you assigned before granted entitlements were"},{"type":"text","text":" "},{"type":"text","text":"applied. Changes are delivered in the order they were made. Subscribers"},{"type":"text","text":" "},{"type":"text","text":"are usually called on the thread that changed the status, which is often"},{"type":"text","text":" "},{"type":"text","text":"a background one; when several threads change it at once, one of them"},{"type":"text","text":" "},{"type":"text","text":"delivers the others’ changes too, and a slow subscriber holds those up."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"receive(on:)"},{"type":"text","text":" before updating UI, and don’t block in a subscriber."}]},{"inlineContent":[{"type":"text","text":"Otherwise, you can check the delegate function"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/subscriptionStatusDidChange(from:to:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to receive a callback whenever the logical status changes."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’ve set "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","isActive":true,"type":"reference"},{"type":"text","text":", they are merged into"},{"type":"text","text":" "},{"type":"text","text":"every value you assign here. Assigning "},{"type":"codeVoice","code":".inactive"},{"type":"text","text":" does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" remove"},{"type":"text","text":" "},{"type":"text","text":"them — the status stays active for as long as "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"contains an active entitlement. To revoke them, set"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements"},{"type":"text","text":" to an empty set."}]}],"name":"Warning","style":"warning","type":"aside"}]}],"variants":[{"paths":["\/documentation\/superwallkit\/superwall\/subscriptionstatus"],"traits":[{"in