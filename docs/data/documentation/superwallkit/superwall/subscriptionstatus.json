de":".inactive","type":"codeVoice"},{"type":"text","text":" does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" remove"},{"type":"text","text":" "},{"type":"text","text":"them — the status stays active for as long as "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","isActive":true},{"text":" ","type":"text"},{"text":"contains an active entitlement. To revoke them, set","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements","isActive":true,"type":"reference"},{"text":" to an empty set.","type":"text"}]}],"name":"Warning","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall"]]},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PublishedSubscriptionStatus":{"abstract":[{"type":"text","text":"The property wrapper behind "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/subscriptionStatus","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PublishedSubscriptionStatus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PublishedSubscriptionStatus"}],"url":"\/documentation\/superwallkit\/publishedsubscriptionstatus","kind":"symbol","title":"PublishedSubscriptionStatus","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PublishedSubscriptionStatus"}],"type":"topic"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/Superwall/subscriptionStatus":{"abstract":[{"type":"text","text":"A published property that indicates the subscription status of the user. If you’re using a"},