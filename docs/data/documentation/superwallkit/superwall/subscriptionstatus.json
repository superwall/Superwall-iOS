lKit\/documentation\/SuperwallKit\/Superwall\/grantedEntitlements"},{"type":"text","text":" to an empty set."}]}],"style":"warning"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall"]]},"metadata":{"roleHeading":"Instance Property","title":"subscriptionStatus","symbolKind":"property","modules":[{"name":"SuperwallKit"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subscriptionStatus","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit18SubscriptionStatusO","text":"SubscriptionStatus","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:12SuperwallKit0A0C18subscriptionStatusAA012SubscriptionD0Ovp"},"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/Superwall\/subscriptionStatus","interfaceLanguage":"swift"},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallDelegate/subscriptionStatusDidChange(from:to:)":{"defaultImplementations":1,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallDelegate\/subscriptionStatusDidChange(from:to:)","required":true,"type":"topic","title":"subscriptionStatusDidChange(from:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subscriptionStatusDidChange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SubscriptionStatus","kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit18SubscriptionStatusO"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SubscriptionStatus","kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit18SubscriptionStatusO"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/superwallkit\/superwalldelegate\/subscriptionstat