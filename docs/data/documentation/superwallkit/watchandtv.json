{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"Use SuperwallKit in watchOS 8+ and tvOS 15+ apps to track purchases, subscription status and entitlements. Install with Swift Package Manager and configure the SDK with the same API as on iOS:"}],"variants":[{"paths":["\/documentation\/superwallkit\/watchandtv"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"title":"watchOS and tvOS","role":"article","modules":[{"name":"SuperwallKit"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"],["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/WatchAndTV"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"code":["import SuperwallKit","","let options = SuperwallOptions()","options.shouldObservePurchases = true","Superwall.configure(apiKey: \"YOUR_PUBLIC_API_KEY\", options: options)"],"type":"codeListing","syntax":"swift"},{"anchor":"Whats-available","type":"heading","level":2,"text":"What’s available"},{"inlineContent":[{"text":"Configuring, identifying users, user attributes, placements, purchases, restores, observer mode, subscription status, entitlements, ","type":"text"},{"type":"codeVoice","code":"CustomerInfo"},{"text":", web checkout redemption and the ","type":"text"},{"type":"codeVoice","code":"SuperwallDelegate"},{"text":" work as on iOS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Neither platform has a web view, so paywalls, the debugger, Test Mode and Customer Center aren’t available. The APIs that only make sense with a paywall on screen, such as ","type":"text"},{"type":"codeVoice","code":"getPaywall"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":", don’t exist on these platforms.","type":"text"}],"type":"paragraph"},{"anchor":"Placements","type":"heading","level":2,"text":"Placements"},{"inlineContent":[{"type":"codeVoice","code":"register(placement:)"},{"text":" still runs the campaign’s audience filters:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A holdout, or a placement with no matching audience, is skipped and runs the feature, as on iOS.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When a paywall would be shown, the feature is unlocked as on iOS when a paywall fails to load. A non-gated feature runs. A gated feature doesn’t, and the handler’s ","type":"text"},{"code":"onError","type":"codeVoice"},{"text":" gets an error instead. If the paywall can’t be fetched, ","type":"text"},{"code":"onError","type":"codeVoice"},{"text":" gets that error. ","type":"text"},{"code":"onPresent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" aren’t called, since nothing is shown.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"getPresentationResult(forPlacement:)"},{"text":" returns the paywall the user would see. Implicit placements, such as ","type":"text"},{"type":"codeVoice","code":"app_launch"},{"text":", don’t trigger anything.","type":"text"}],"type":"paragraph"},{"anchor":"Platform-differences","type":"heading","level":2,"text":"Platform differences"},{"items":[{"content":[{"inlineContent":[{"text":"tvOS: local notifications, such as free trial reminders, aren’t scheduled because tvOS notifications can’t show text.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"watchOS: the connection type is reported as ","type":"text"},{"code":"Unknown","type":"codeVoice"},{"text":". The device’s interface type is ","type":"text"},{"code":"watch","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"MMP install matching and Apple Search Ads attribution don’t run on either platform.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"CocoaPods doesn’t install SuperwallKit on these platforms.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"https://superwall.com":{"url":"https:\/\/superwall.com","title":"Superwall","type":"link","identifier":"https:\/\/superwall.com","titleInlineContent":[{"text":"Superwall","type":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"url":"\/documentation\/superwallkit","title":"SuperwallKit","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","abstract":[]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallKit":{"url":"\/documentation\/superwallkit\/superwallkit","title":"`SuperwallKit`","role":"collectionGroup","kind":"article","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallKit","abstract":[{"type":"text","text":"The client SDK for "},{"isActive":true,"type":"reference","identifier":"https:\/\/superwall.com"},{"type":"text","text":", a service that lets you remotely configure, present and iterate paywalls – helping you find winners quickly."}]}}}