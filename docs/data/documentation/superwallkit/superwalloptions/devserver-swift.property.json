{"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" server, for development builds only.","type":"text"}],"metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"devServer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"text":"?","kind":"text"}],"externalID":"s:12SuperwallKit0A7OptionsC9devServerAC03DevE0OSgvp","symbolKind":"property","title":"devServer","modules":[{"name":"SuperwallKit"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@nonobjc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"devServer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DevServer","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"kind":"text","text":"?"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Paywalls with a local counterpart on the dev server then render from your live, local","type":"text"},{"text":" ","type":"text"},{"text":"paywall code instead of their published versions, while configuration, placements,","type":"text"},{"text":" ","type":"text"},{"text":"audience evaluation, assignment and the enforcement of feature gating all stay real.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Paywalls without a local counterpart still load their published versions."}],"type":"paragraph"},{"inlineContent":[{"text":"What the local surface owns is what it renders and the settings its ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"declares: content, products, presentation style, feature gating, intro offer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"eligibility, scrolling and background colours all come from your local code, so"},{"type":"text","text":" "},{"type":"text","text":"changing them shows on the next presentation without a push. What "},{"type":"codeVoice","code":"config.ts"},{"text":" ","type":"text"},{"text":"cannot express — surveys, computed properties — comes from the published paywall","type":"text"},{"text":" ","type":"text"},{"text":"the surface stands in for, and so does any setting your ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" leaves out.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A dev server older than this SDK sends no settings at all, in which case every"},{"type":"text","text":" "},{"text":"setting comes from the published paywall.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two exceptions. Local notifications are always the local paywall’s: the published","type":"text"},{"text":" ","type":"text"},{"text":"ones are ignored and the ones your ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" declares fire without a push, because","type":"text"},{"text":" ","type":"text"},{"text":"they reach the SDK from the paywall itself rather than from the dashboard. And the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"on-device cache stays off however either side configures it, so a page you are"},{"type":"text","text":" "},{"type":"text","text":"editing is never served from the web view’s cache."}]},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default"},{"text":" on a simulator; on a physical device use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)"},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"type":"codeVoice","code":"Device"},{"text":" URL that ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" prints. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":": no dev server.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The dev server also activates test mode (simulated purchases, product data from the"},{"type":"text","text":" "},{"type":"text","text":"dashboard), disables paywall preloading, and skips the test mode intro sheet."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The host app must allow local networking in its "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"type":"text","text":" → "},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"type":"text","text":"). That one key covers"},{"type":"text","text":" "},{"text":"every address ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" prints: "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":", "},{"type":"codeVoice","code":".local"},{"type":"text","text":" hosts, and the"},{"type":"text","text":" "},{"type":"text","text":"plain IP address in the "},{"type":"codeVoice","code":"Device"},{"type":"text","text":" URL, which App Transport Security stopped"},{"type":"text","text":" "},{"type":"text","text":"permitting by default in iOS 17."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/default":{"type":"topic","abstract":[{"text":"Finds the dev server on ","type":"text"},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" ports 6100–6104, which reaches a server"},{"type":"text","text":" "},{"type":"text","text":"running on the same machine from a simulator."}],"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/default","title":"SuperwallOptions.DevServer.default","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`default`","kind":"identifier"}],"kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions":{"type":"topic","kind":"symbol","title":"SuperwallOptions","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions","url":"\/documentation\/superwallkit\/superwalloptions","abstract":[{"type":"text","text":"Options for configuring Superwall, including paywall presentation and appearance."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuperwallOptions","kind":"identifier"}],"navigatorTitle":[{"text":"SuperwallOptions","kind":"identifier"}],"role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/url(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"url","kind":"identifier"},{"text":"(","kind":"text"},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/url(_:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","title":"SuperwallOptions.DevServer.url(_:)","abstract":[{"text":"The dev server at an exact address — the ","type":"text"},{"code":"Device","type":"codeVoice"},{"text":" URL’s origin that","type":"text"},{"text":" ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"type":"text","text":" prints, e.g. "},{"type":"codeVoice","code":"http:\/\/192.168.1.10:6100"},{"text":". Use this on a","type":"text"},{"text":" ","type":"text"},{"text":"physical device, which can’t reach your machine via ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":".","type":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","title":"SuperwallKit","kind":"symbol","abstract":[],"url":"\/documentation\/superwallkit","role":"collection"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/devServer-swift.property":{"title":"devServer","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property","abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server, for development builds only.","type":"text"}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DevServer","kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"text":"?","kind":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum":{"kind":"symbol","abstract":[{"type":"text","text":"A running "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" server for "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","isActive":true},{"type":"text","text":" to connect to."}],"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum","title":"SuperwallOptions.DevServer","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DevServer"}],"navigatorTitle":[{"kind":"identifier","text":"DevServer"}],"type":"topic"}}}