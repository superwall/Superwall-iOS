{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property"},"sections":[],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@nonobjc","kind":"attribute"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"devServer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"kind":"text","text":"?"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paywalls with a local counterpart on the dev server then render from your live, local"},{"type":"text","text":" "},{"type":"text","text":"paywall code instead of their published versions, while configuration, placements,"},{"type":"text","text":" "},{"type":"text","text":"audience evaluation, assignment and the enforcement of feature gating all stay real."},{"type":"text","text":" "},{"text":"Paywalls without a local counterpart still load their published versions.","type":"text"}]},{"inlineContent":[{"type":"text","text":"What the local surface owns is what it renders and the settings its "},{"code":"config.ts","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"declares: content, products, presentation style, feature gating, intro offer"},{"type":"text","text":" "},{"type":"text","text":"eligibility, scrolling and background colours all come from your local code, so"},{"type":"text","text":" "},{"type":"text","text":"changing them shows on the next presentation without a push. What "},{"code":"config.ts","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"cannot express — surveys, computed properties — comes from the published paywall"},{"type":"text","text":" "},{"type":"text","text":"the surface stands in for, and so does any setting your "},{"code":"config.ts","type":"codeVoice"},{"type":"text","text":" leaves out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A dev server older than this SDK sends no settings at all, in which case every"},{"type":"text","text":" "},{"type":"text","text":"setting comes from the published paywall."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two exceptions. Local notifications are always the local paywall’s: the published"},{"type":"text","text":" "},{"text":"ones are ignored and the ones your ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" declares fire without a push, because","type":"text"},{"text":" ","type":"text"},{"text":"they reach the SDK from the paywall itself rather than from the dashboard. And the","type":"text"},{"text":" ","type":"text"},{"text":"on-device cache stays off however either side configures it, so a page you are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"editing is never served from the web view’s cache."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default","isActive":true,"type":"reference"},{"text":" on a simulator; on a physical device use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"type":"codeVoice","code":"Device"},{"text":" URL that ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" prints. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":": no dev server."}],"type":"paragraph"},{"inlineContent":[{"text":"The dev server also activates test mode (simulated purchases, product data from the","type":"text"},{"text":" ","type":"text"},{"text":"dashboard), disables paywall preloading, and skips the test mode intro sheet.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The host app must allow local networking in its "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"type":"text","text":" → "},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"type":"text","text":"). That one key covers"},{"type":"text","text":" "},{"type":"text","text":"every address "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" prints: "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":", "},{"code":".local","type":"codeVoice"},{"type":"text","text":" hosts, and the"},{"type":"text","text":" "},{"type":"text","text":"plain IP address in the "},{"code":"Device","type":"codeVoice"},{"type":"text","text":" URL, which App Transport Security stopped"},{"type":"text","text":" "},{"type":"text","text":"permitting by default in iOS 17."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server, for development builds only.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SuperwallKit"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property","title":"devServer","role":"symbol","externalID":"s:12SuperwallKit0A7OptionsC9devServerAC03DevE0OSgvp","symbolKind":"property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property"]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/devServer-swift.property":{"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property","abstract":[{"type":"text","text":"Connects this SDK instance to a running "},{"code":"superwall dev","type":"codeVoice"},{"type":"text","text":" server, for development builds only."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","kind":"typeIdentifier","text":"DevServer"},{"kind":"text","text":"?"}],"title":"devServer","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"url":"\/documentation\/superwallkit","abstract":[],"role":"collection","kind":"symbol","type":"topic","title":"SuperwallKit","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","role":"symbol","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DevServer"}],"abstract":[{"type":"text","text":"A running "},{"code":"superwall dev","type":"codeVoice"},{"type":"text","text":" server for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property"},{"type":"text","text":" to connect to."}],"type":"topic","kind":"symbol","title":"SuperwallOptions.DevServer","navigatorTitle":[{"kind":"identifier","text":"DevServer"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions":{"url":"\/documentation\/superwallkit\/superwalloptions","abstract":[{"type":"text","text":"Options for configuring Superwall, including paywall presentation and appearance."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuperwallOptions","kind":"identifier"}],"navigatorTitle":[{"text":"SuperwallOptions","kind":"identifier"}],"title":"SuperwallOptions","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/url(_:)":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","role":"symbol","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/url(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"url"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:10Foundation3URLV"},{"kind":"text","text":")"}],"abstract":[{"text":"The dev server at an exact address — the ","type":"text"},{"code":"Device","type":"codeVoice"},{"text":" URL’s origin that","type":"text"},{"text":" ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" prints, e.g. ","type":"text"},{"code":"http:\/\/192.168.1.10:6100","type":"codeVoice"},{"text":". Use this on a","type":"text"},{"text":" ","type":"text"},{"text":"physical device, which can’t reach your machine via ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","title":"SuperwallOptions.DevServer.url(_:)"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/default":{"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/default","abstract":[{"text":"Finds the dev server on ","type":"text"},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" ports 6100–6104, which reaches a server"},{"type":"text","text":" "},{"type":"text","text":"running on the same machine from a simulator."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"`default`","kind":"identifier"}],"title":"SuperwallOptions.DevServer.default","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default"}}}