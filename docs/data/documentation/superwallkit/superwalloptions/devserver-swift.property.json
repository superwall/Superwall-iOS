{"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property"},"abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server, for development builds only.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@nonobjc","kind":"attribute"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"devServer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","text":"DevServer"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Paywalls with a local counterpart on the dev server then render from your live, local","type":"text"},{"text":" ","type":"text"},{"text":"paywall code instead of their published versions, while configuration, placements,","type":"text"},{"text":" ","type":"text"},{"text":"audience evaluation, assignment and the enforcement of feature gating all stay real.","type":"text"},{"text":" ","type":"text"},{"text":"Paywalls without a local counterpart still load their published versions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What the local surface owns is what it renders and the settings its "},{"code":"config.ts","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"declares: content, products, presentation style, feature gating, intro offer"},{"type":"text","text":" "},{"type":"text","text":"eligibility, scrolling and background colours all come from your local code, so"},{"type":"text","text":" "},{"type":"text","text":"changing them shows on the next presentation without a push. What "},{"code":"config.ts","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"cannot express — surveys, computed properties — comes from the published paywall"},{"type":"text","text":" "},{"type":"text","text":"the surface stands in for, and so does any setting your "},{"type":"codeVoice","code":"config.ts"},{"type":"text","text":" leaves out."}]},{"inlineContent":[{"text":"A dev server older than this SDK sends no settings at all, in which case every","type":"text"},{"type":"text","text":" "},{"type":"text","text":"setting comes from the published paywall."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two exceptions. Local notifications are always the local paywall’s: the published"},{"type":"text","text":" "},{"type":"text","text":"ones are ignored and the ones your "},{"code":"config.ts","type":"codeVoice"},{"type":"text","text":" declares fire without a push, because"},{"type":"text","text":" "},{"type":"text","text":"they reach the SDK from the paywall itself rather than from the dashboard. And the"},{"type":"text","text":" "},{"type":"text","text":"on-device cache stays off however either side configures it, so a page you are"},{"type":"text","text":" "},{"type":"text","text":"editing is never served from the web view’s cache."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default"},{"text":" on a simulator; on a physical device use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)"},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"type":"codeVoice","code":"Device"},{"text":" URL that ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" prints. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":": no dev server.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The dev server also activates test mode (simulated purchases, product data from the","type":"text"},{"text":" ","type":"text"},{"text":"dashboard), disables paywall preloading, and skips the test mode intro sheet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The host app must allow local networking in its ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"text":"). That one key covers","type":"text"},{"text":" ","type":"text"},{"text":"every address ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" prints: ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":", ","type":"text"},{"type":"codeVoice","code":".local"},{"text":" hosts, and the","type":"text"},{"text":" ","type":"text"},{"text":"plain IP address in the ","type":"text"},{"type":"codeVoice","code":"Device"},{"text":" URL, which App Transport Security stopped","type":"text"},{"text":" ","type":"text"},{"text":"permitting by default in iOS 17.","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"role":"symbol","title":"devServer","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"devServer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","text":"DevServer"},{"kind":"text","text":"?"}],"externalID":"s:12SuperwallKit0A7OptionsC9devServerAC03DevE0OSgvp","roleHeading":"Instance Property","modules":[{"name":"SuperwallKit"}],"symbolKind":"property"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property"]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/devServer-swift.property":{"type":"topic","title":"devServer","abstract":[{"type":"text","text":"Connects this SDK instance to a running "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" server, for development builds only."}],"role":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"url":"\/documentation\/superwallkit","title":"SuperwallKit","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","abstract":[]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions":{"navigatorTitle":[{"text":"SuperwallOptions","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuperwallOptions","kind":"identifier"}],"title":"SuperwallOptions","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions","url":"\/documentation\/superwallkit\/superwalloptions","abstract":[{"text":"Options for configuring Superwall, including paywall presentation and appearance.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum":{"type":"topic","title":"SuperwallOptions.DevServer","abstract":[{"type":"text","text":"A running "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" server for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property"},{"type":"text","text":" to connect to."}],"role":"symbol","navigatorTitle":[{"text":"DevServer","kind":"identifier"}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DevServer","kind":"identifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/url(_:)":{"type":"topic","title":"SuperwallOptions.DevServer.url(_:)","abstract":[{"type":"text","text":"The dev server at an exact address — the "},{"type":"codeVoice","code":"Device"},{"type":"text","text":" URL’s origin that"},{"type":"text","text":" "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" prints, e.g. "},{"type":"codeVoice","code":"http:\/\/192.168.1.10:6100"},{"type":"text","text":". Use this on a"},{"type":"text","text":" "},{"type":"text","text":"physical device, which can’t reach your machine via "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/url(_:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"url",