{"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@nonobjc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","text":"DevServer","kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"text":"?","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Paywalls with a local counterpart on the dev server then render from your live, local","type":"text"},{"text":" ","type":"text"},{"text":"paywall code instead of their published versions, while configuration, placements,","type":"text"},{"text":" ","type":"text"},{"text":"audience evaluation, assignment and the enforcement of feature gating all stay real.","type":"text"},{"text":" ","type":"text"},{"text":"Paywalls without a local counterpart still load their published versions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"What the local surface owns is what it renders and the settings its ","type":"text"},{"type":"codeVoice","code":"config.ts"},{"text":" ","type":"text"},{"text":"declares: content, products, presentation style, feature gating, intro offer","type":"text"},{"text":" ","type":"text"},{"text":"eligibility, scrolling and background colours all come from your local code, so","type":"text"},{"text":" ","type":"text"},{"text":"changing them shows on the next presentation without a push. What ","type":"text"},{"type":"codeVoice","code":"config.ts"},{"text":" ","type":"text"},{"text":"cannot express — surveys, computed properties — comes from the published paywall","type":"text"},{"text":" ","type":"text"},{"text":"the surface stands in for, and so does any setting your ","type":"text"},{"type":"codeVoice","code":"config.ts"},{"text":" leaves out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A dev server older than this SDK sends no settings at all, in which case every","type":"text"},{"text":" ","type":"text"},{"text":"setting comes from the published paywall.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two exceptions. Local notifications are always the local paywall’s: the published","type":"text"},{"text":" ","type":"text"},{"text":"ones are ignored and the ones your ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" declares fire without a push, because","type":"text"},{"text":" ","type":"text"},{"text":"they reach the SDK from the paywall itself rather than from the dashboard. And the","type":"text"},{"text":" ","type":"text"},{"text":"on-device cache stays off however either side configures it, so a page you are","type":"text"},{"text":" ","type":"text"},{"text":"editing is never served from the web view’s cache.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default","type":"reference","isActive":true},{"text":" on a simulator; on a physical device use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"type":"codeVoice","code":"Device"},{"text":" URL that ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" prints. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":": no dev server.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The dev server also activates test mode (simulated purchases, product data from the","type":"text"},{"text":" ","type":"text"},{"text":"dashboard), disables paywall preloading, and skips the test mode intro sheet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The host app must allow local networking in its ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"type":"text","text":" → "},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"type":"text","text":"). That one key covers"},{"type":"text","text":" "},{"type":"text","text":"every address "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" prints: "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":", "},{"type":"codeVoice","code":".local"},{"type":"text","text":" hosts, and the"},{"type":"text","text":" "},{"type":"text","text":"plain IP address in the "},{"type":"codeVoice","code":"Device"},{"type":"text","text":" URL, which App Transport Security stopped"},{"type":"text","text":" "},{"type":"text","text":"permitting by default in iOS 17."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" server, for development builds only.","type":"text"}],"metadata":{"role":"symbol","title":"devServer","externalID":"s:12SuperwallKit0A7OptionsC9devServerAC03DevE0OSgvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property","modules":[{"name":"SuperwallKit"}],"roleHeading":"Instance Property"},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/devServer-swift.property":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","text":"DevServer","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","type":"topic","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property","abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server, for development builds only.","type":"text"}],"title":"devServer","role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions":{"role":"symbol","title":"SuperwallOptions","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions","navigatorTitle":[{"kind":"identifier","text":"SuperwallOptions"}],"kind":"symbol","type":"topic","abstract":[{"text":"Options for configuring Superwall, including paywall presentation and appearance.","type":"text"}],"url":"\/documentation\/superwallkit\/superwalloptions","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuperwallOptions"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","title":"SuperwallOptions.DevServer","kind":"symbol","navigatorTitle":[{"text":"DevServer","kind":"identifier"}],"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum","type":"topic","role":"symbol","abstract":[{"text":"A running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","type":"reference"},{"text":" to connect to.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DevServer","kind":"identifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/url(_:)":{"abstract":[{"text":"The dev server at an exact address — the ","type":"text"},{"type":"codeVoice","code":"Device"},{"text":" URL’s origin that","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"superwall dev"},{"text":" prints, e.g. ","type":"text"},{"type":"codeVoice","code":"http:\/\/192.168.1.10:6100"},{"text":". Use this on a","type":"text"},{"text":" ","type":"text"},{"text":"physical device, which can’t reach your machine via ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":".","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"url","kind":"identifier"},{"text":"(","kind":"text"},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","title":"SuperwallOptions.DevServer.url(_:)","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/url(_:)","kind":"symbol","type":"topic"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/default":{"a