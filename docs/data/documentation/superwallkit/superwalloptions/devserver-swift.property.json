{"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"]]},"metadata":{"symbolKind":"property","externalID":"s:12SuperwallKit0A7OptionsC9devServerAC03DevE0OSgvp","title":"devServer","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"modules":[{"name":"SuperwallKit"}],"roleHeading":"Instance Property"},"abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server, for development builds only.","type":"text"}],"variants":[{"paths":["\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"@nonobjc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devServer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DevServer","kind":"typeIdentifier","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Paywalls with a local counterpart on the dev server then render from your live, local"},{"type":"text","text":" "},{"type":"text","text":"paywall code instead of their published versions, while configuration, placements,"},{"text":" ","type":"text"},{"text":"audience evaluation, assignment and the enforcement of feature gating all stay real.","type":"text"},{"text":" ","type":"text"},{"text":"Paywalls without a local counterpart still load their published versions.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"What the local surface owns is what it renders and the settings its ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"declares: content, products, presentation style, feature gating, intro offer","type":"text"},{"text":" ","type":"text"},{"text":"eligibility, scrolling and background colours all come from your local code, so","type":"text"},{"text":" ","type":"text"},{"text":"changing them shows on the next presentation without a push. What ","type":"text"},{"code":"config.ts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"cannot express — surveys, computed properties — comes from the published paywall","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the surface stands in for, and so does any setting your "},{"code":"config.ts","type":"codeVoice"},{"text":" leaves out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A dev server older than this SDK sends no settings at all, in which case every"},{"type":"text","text":" "},{"type":"text","text":"setting comes from the published paywall."}]},{"type":"paragraph","inlineContent":[{"text":"Two exceptions. Local notifications are always the local paywall’s: the published","type":"text"},{"text":" ","type":"text"},{"text":"ones are ignored and the ones your ","type":"text"},{"type":"codeVoice","code":"config.ts"},{"type":"text","text":" declares fire without a push, because"},{"type":"text","text":" "},{"type":"text","text":"they reach the SDK from the paywall itself rather than from the dashboard. And the"},{"type":"text","text":" "},{"type":"text","text":"on-device cache stays off however either side configures it, so a page you are"},{"type":"text","text":" "},{"type":"text","text":"editing is never served from the web view’s cache."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default","type":"reference"},{"text":" on a simulator; on a physical device use ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"with the "},{"code":"Device","type":"codeVoice"},{"type":"text","text":" URL that "},{"code":"superwall dev","type":"codeVoice"},{"text":" prints. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":": no dev server."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dev server also activates test mode (simulated purchases, product data from the"},{"type":"text","text":" "},{"type":"text","text":"dashboard), disables paywall preloading, and skips the test mode intro sheet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host app must allow local networking in its "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"NSAppTransportSecurity","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"NSAllowsLocalNetworking","type":"codeVoice"},{"text":"). That one key covers","type":"text"},{"text":" ","type":"text"},{"text":"every address ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" prints: ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":", ","type":"text"},{"type":"codeVoice","code":".local"},{"text":" hosts, and the","type":"text"},{"text":" ","type":"text"},{"text":"plain IP address in the ","type":"text"},{"type":"codeVoice","code":"Device"},{"type":"text","text":" URL, which App Transport Security stopped"},{"type":"text","text":" "},{"type":"text","text":"permitting by default in iOS 17."}]}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"abstract":[],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","kind":"symbol","role":"collection","title":"SuperwallKit","url":"\/documentation\/superwallkit","type":"topic"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/default":{"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/default","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/default","role":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`default`","kind":"identifier"}],"title":"SuperwallOptions.DevServer.default","abstract":[{"text":"Finds the dev server on ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" ports 6100–6104, which reaches a server","type":"text"},{"text":" ","type":"text"},{"text":"running on the same machine from a simulator.","type":"text"}],"kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/devServer-swift.property":{"kind":"symbol","abstract":[{"text":"Connects this SDK instance to a running ","type":"text"},{"code":"superwall dev","type":"codeVoice"},{"text":" server, for development builds only.","type":"text"}],"url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.property","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"devServer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DevServer","preciseIdentifier":"s:12SuperwallKit0A7OptionsC9DevServerO"},{"kind":"text","text":"?"}],"type":"topic","title":"devServer"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum":{"kind":"symbol","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum","abstract":[{"type":"text","text":"A running "},{"code":"superwall dev","type":"codeVoice"},{"type":"text","text":" server for "},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/devServer-swift.property","type":"reference"},{"type":"text","text":" to connect to."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DevServer","kind":"identifier"}],"navigatorTitle":[{"text":"DevServer","kind":"identifier"}],"type":"topic","title":"SuperwallOptions.DevServer"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions/DevServer-swift.enum/url(_:)":{"abstract":[{"type":"text","text":"The dev server at an exact address — the "},{"type":"codeVoice","code":"Device"},{"type":"text","text":" URL’s origin that"},{"type":"text","text":" "},{"type":"codeVoice","code":"superwall dev"},{"type":"text","text":" prints, e.g. "},{"type":"codeVoice","code":"http:\/\/192.168.1.10:6100"},{"type":"text","text":". Use this on a"},{"type":"text","text":" "},{"type":"text","text":"physical device, which can’t reach your machine via "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":"."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"url","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/DevServer-swift.enum\/url(_:)","type":"topic","title":"SuperwallOptions.DevServer.url(_:)","url":"\/documentation\/superwallkit\/superwalloptions\/devserver-swift.enum\/url(_:)"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/SuperwallOptions":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SuperwallOptions"}],"title":"SuperwallOptions","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Options for configuring Superwall, including paywall presentation and appearance."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuperwallOptions"}],"url":"\/documentation\/superwallkit\/superwalloptions"}}}