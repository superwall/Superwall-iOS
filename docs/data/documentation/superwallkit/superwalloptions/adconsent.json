{"sections":[],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/SuperwallOptions\/adConsent","interfaceLanguage":"swift"},"metadata":{"externalID":"c:@M@SuperwallKit@objc(cs)SWKSuperwallOptions(py)adConsent","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"adConsent"},{"kind":"text","text":": "},{"text":"AdConsent","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKAdConsent","kind":"typeIdentifier"}],"role":"symbol","symbolKind":"property","modules":[{"name":"SuperwallKit"}],"title":"adConsent"},"abstract":[{"type":"text","text":"The user’s consent for how their data is used for advertising, which Superwall"},{"type":"text","text":" "},{"type":"text","text":"passes on with the conversions it uploads to Google Ads and Meta."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"adConsent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/AdConsent","kind":"typeIdentifier","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKAdConsent","text":"AdConsent"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"adConsent"},{"type":"text","text":" is never set, the SDK uses the consent stored by an IAB TCF consent"},{"type":"text","te