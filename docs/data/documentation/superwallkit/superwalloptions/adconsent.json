{"abstract":[{"text":"The user’s consent for how their data is used for advertising, which Superwall","type":"text"},{"text":" ","type":"text"},{"text":"passes on with the conversions it uploads to Google Ads and Meta.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/superwalloptions\/adconsent"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adConsent","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/AdConsent","text":"AdConsent","kind":"typeIdentifier","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKAdConsent"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"If "},{"code":"adConsent","type":"codeVoice"},{"type":"text","text":" is never set, the SDK uses the consent stored by an IAB TCF consent"},{"type":"text","text":" "},{"type":"text","text":"banner when GDPR applies, and otherwise defaults to granted; apps with users in"},{"type":"text","text":" "},{"type":"text","text":"the EEA, UK or Switzerland that don’t use a TCF banner should set it from their"},{"type":"text","text":" "},{"type":"text","text":"consent flow. Where the values came from is reported in the "},{"code":"adConsentSource","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"device attribute ("},{"code":"developer","type":"codeVoice"},{"type":"text","text":", "},{"code":"tcf","type":"codeVoice"},{"type":"text","text":" or "},{"code":"default","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type"