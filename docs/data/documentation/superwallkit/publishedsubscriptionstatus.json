"text","text":"Every assignment is routed through "},{"type":"codeVoice","code":"publishSubscriptionStatus"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"text","text":"stored and published value is always the merged one — subscribers never"},{"type":"text","text":" "},{"type":"text","text":"see the value a writer assigned before granted entitlements and test-mode"},{"type":"text","text":" "},{"type":"text","text":"overrides were applied. The projected value ("},{"type":"codeVoice","code":"$subscriptionStatus"},{"type":"text","text":") replays"},{"type":"text","text":" "},{"type":"text","text":"the latest emitted value to new subscribers, like "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":"; while"},{"type":"text","text":" "},{"type":"text","text":"emissions are queued behind a slow subscriber, that replay can trail the"},{"type":"text","text":" "},{"type":"text","text":"stored value until its turn comes. Reads take the same lock as writes,"},{"type":"text","text":" "},{"type":"text","text":"so a read on one thread never races an assignment on another."}]},{"inlineContent":[{"text":"Public only because a public property’s wrapper type has to be; nothing","type":"text"},{"text":" ","type":"text"},{"text":"but the projection is meant to be used. The enclosing-instance subscript","type":"text"},{"text":" ","type":"text"},{"text":"is the same mechanism ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" itself uses to reach its owner.","type":"text"}],"type":"paragraph"}]}],"sections":[],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PublishedSubscriptionStatus":{"type":"topic","kind":"symbol","title":"PublishedSubscriptionStatus","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PublishedSubscriptionStatus","abstract":[{"type":"text","text":"The property wrapper behind "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKi