ams"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"paywallOverrides"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PaywallOverrides","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallOverrides","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"onRequestDismiss"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","text":"PaywallInfo","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallInfo","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallInfo"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit13PaywallResultO","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallResult","text":"PaywallResult","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")? = nil, ","kind":"text"},{"text":"onSkippedView","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit20PaywallSkippedReasonO","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason","text":"PaywallSkippedReason","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit11PaywallViewVAAs5NeverORszrlE09OnSkippedD0q_mfp","text":"OnSkippedView","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"feature","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")? = nil)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"placement","content":[{"inlineContent":[{"type":"text","text":"The name of the placement, as you have defined on the Superwall dashboard."}],"type":"paragraph"}]},{"name":"params","content":[{"type":"paragraph","inlineContent":[{"text":"Optional parameters you’d like to pass with your placement. These can be referenced within the rules","type":"text"},{"text":" ","type":"text"},{"text":"of your campaign. Keys beginning with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" are reserved for Superwall and will be dropped. Values can be any","type":"text"},{"text":" ","type":"text"},{"text":"JSON encodable value, URLs or Dates. Arrays and dictionaries as values are not supported at this time, and will","type":"text"},{"text":" ","type":"text"},{"text":"be dropped.","type":"text"}]}]},{"name":"paywallOverrides","content":[{"inlineContent":[{"type":"text","text":"An optional "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides","isActive":true,"type":"reference"},{"type":"text","text":" object whose parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"onRequestDismiss","content":[{"type":"paragraph","inlineContent":[{"text":"An optional completion block that gets called when the paywall should dismiss. This defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and the SDK","type":"text"},{"text":" ","type":"text"},{"text":"will call ","type":"text"},{"code":"presentationMode.wrappedValue.dismiss()","type":"codeVoice"},{"text":" by default. Otherwise you must perform the dismissal of the paywall.","type":"text"}]}]},{"name":"onSkippedView","content":[{"inlineContent":[{"type":"text","text":"A completion block that accepts a "},{"isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason","type":"reference"},{"type":"text","text":" and returns an "},{"type":"codeVoice","code":"View"},{"type":"text","text":". This will show"},{"type":"text","text":" "},{"type":"text","text":"when the requested paywall is skipped. Defaults to "},{"type":"codeVoice","code":"EmptyView()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"feature","content":[{"inlineContent":[{"type":"text","text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/superwall.com\/dashboard","isActive":true},{"type":"text","text":". If the paywall is set to "},{"type":"emphasis","inlineContent":[{"text":"Non Gated","type":"text"}]},{"type":"text","text":", this will be called when"},{"type":"text","text":" "},{"type":"text","text":"the paywall is dismissed or if the user is already paying. If the paywall is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Gated"}]},{"text":", this will be called only if the user is already paying","type":"text"},{"text":" ","type":"text"},{"text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This uses ","type":"text"},{"type":"codeVoice","code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)"},{"text":" under the hood.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You’re responsible for the deallocation of this view. If you have a "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" presented somewhere"},{"type":"text","text":" "},{"type":"text","text":"and you try to present the same "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" elsewhere, you will get a crash."}]}],"type":"aside","name":"Warning","style":"warning"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallView"]]},"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallInfo":{"navigatorTitle":[{"kind":"identifier","text":"PaywallInfo"}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallInfo","type":"topic","title":"PaywallInfo","abstract":[{"text":"Contains information about a paywall.","type":"text"}],"url":"\/documentation\/superwallkit\/paywallinfo","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallInfo"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallView":{"abstract":[{"type":"text","text":"A SwiftUI paywall view that you can embed into your app."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallView","kind":"symbol","title":"PaywallView","navigatorTitle":[{"kind":"identifier","text":"PaywallView"}],"url":"\/documentation\/superwallkit\/paywallview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallView"}],"role":"symbol","type":"topic"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallResult":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallResult","abstract":[{"type":"text","text":"Contains the possible reasons for the dismissal of a paywall."}],"title":"PaywallResult","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallResult"}],"url":"\/documentation\/superwallkit\/paywallresult","navigatorTitle":[{"text":"Pay