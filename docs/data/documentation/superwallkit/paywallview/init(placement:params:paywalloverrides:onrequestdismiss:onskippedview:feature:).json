ence","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides"},{"type":"text","text":" object whose parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"name":"onRequestDismiss","content":[{"type":"paragraph","inlineContent":[{"text":"An optional completion block that gets called when the paywall should dismiss. This defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and the SDK","type":"text"},{"text":" ","type":"text"},{"text":"will call ","type":"text"},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"text":" by default. Otherwise you must perform the dismissal of the paywall.","type":"text"}]}]},{"name":"onSkippedView","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block that accepts a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason"},{"type":"text","text":" and returns an "},{"code":"View","type":"codeVoice"},{"type":"text","text":". This will show"},{"type":"text","text":" "},{"type":"text","text":"when the requested paywall is skipped. Defaults to "},{"code":"EmptyView()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"feature","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/superwall.com\/dashboard","isActive":true},{"type":"text","text":". If the paywall is set to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Non Gated"}]},{"type":"text","text":", this will be called when"},{"type":"text","text"