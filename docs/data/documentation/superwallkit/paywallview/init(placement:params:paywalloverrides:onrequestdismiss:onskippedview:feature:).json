 parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"onRequestDismiss","content":[{"type":"paragraph","inlineContent":[{"text":"An optional completion block that gets called when the paywall should dismiss. This defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and the SDK"},{"type":"text","text":" "},{"type":"text","text":"will call "},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"type":"text","text":" by default. Otherwise you must perform the dismissal of the paywall."}]}]},{"name":"onSkippedView","content":[{"inlineContent":[{"type":"text","text":"A completion block that accepts a "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason","isActive":true},{"type":"text","text":" and returns an "},{"code":"View","type":"codeVoice"},{"type":"text","text":". This will show"},{"type":"text","text":" "},{"type":"text","text":"when the requested paywall is skipped. Defaults to "},{"code":"EmptyView()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"feature","content":[{"type":"paragraph","inlineContent":[{"text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/superwall.com\/dashboard","isActive":true,"type":"reference"},{"text":". If the paywall is set to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Non Gated"}]},{"text":", this will be called when","type":"text"},{"text":" ","type":"text"},{"text":"the paywall is dismissed or if the user is already paying. If the paywall is ","type":"text"},{"type":"emphasis","inlineCo