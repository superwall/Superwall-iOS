:"s:s4Voida"},{"kind":"text","text":")? = nil)"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the placement, as you have defined on the Superwall dashboard."}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional parameters you’d like to pass with your placement. These can be referenced within the rules"},{"type":"text","text":" "},{"type":"text","text":"of your campaign. Keys beginning with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" are reserved for Superwall and will be dropped. Values can be any"},{"type":"text","text":" "},{"type":"text","text":"JSON encodable value, URLs or Dates. Arrays and dictionaries as values are not supported at this time, and will"},{"type":"text","text":" "},{"type":"text","text":"be dropped."}]}],"name":"params"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides","type":"reference","isActive":true},{"type":"text","text":" object whose parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"paywallOverrides"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional completion block that gets called when the paywall should dismiss. This defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and the SDK"},{"type":"text","text":" "},{"type":"text","text":"will call "},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"type":"text","text":" by default. Otherwise you must perform the dismissal of the paywall."}]}],"name":"onRequestDismiss"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block that accepts a "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason","type":"reference","isActive":true},{"type":"text","text":" and returns an "},{"type":"codeVoice","code":"View"},{"type":"text","text":". This will show"},{"type":"text","text":" "},{"type":"text","text":"when the requested paywall is skipped. Defaults to "},{"type":"codeVoice","code":"EmptyView()"},{"type":"text","text":"."}]}],"name":"onSkippedView"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the"},{"type":"text","text":" "},{"identifier":"https:\/\/superwall.com\/dashboard","type":"reference","isActive":true},{"type":"text","text":". If the paywall is set to "},{"inlineContent":[{"type":"text","text":"Non Gated"}],"type":"emphasis"},{"type":"text","text":", this will be called when"},{"type":"text","text":" "},{"type":"text","text":"the paywall is dismissed or if the user is already paying. If the paywall is "},{"inlineContent":[{"type":"text","text":"Gated"}],"type":"emphasis"},{"type":"text","text":", this will be called only if the user is already paying"},{"type":"text","text":" "},{"type":"text","text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error."}]}],"name":"feature"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This uses "},{"type":"codeVoice","code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)"},{"type":"text","text":" under the hood."}]},{"type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You’re responsible for the deallocation of this view. If you have a "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" presented somewhere"},{"type":"text","text":" "},{"type":"text","text":"and you try to present the same "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" elsewhere, you will get a crash."}]}],"name":"Warning"}],"kind":"content"}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallView":{"abstract":[{"type":"text","text":"A SwiftUI paywall view that you can embed into your app."}],"navigatorTitle":[{"kind":"identifier","text":"PaywallView"}],"role":"symbol","title":"PaywallView","type":"topic","url":"\/documentation\/superwallkit\/paywallview","kind":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallView"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallView/init(placement:params:paywallOverrides:onRequestDismiss:onSkippedView:feature:)":{"kind":"symbol","title":"init(placement:params:paywallOverrides:onRequestDismiss:onSkippedView:feature:)","abstract":[{"type":"text","text":"A SwiftUI paywall view that you can embed into your app."}],"role":"symbol","type":"topic","url":"\/documentation\/superwallkit\/paywallview\/init(placement:params:paywalloverrides:onrequestdismiss:onskippedview:feature:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"params","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"]?, ","kind":"text"},{"text":"paywallOverrides","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Paywal