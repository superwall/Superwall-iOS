 elsewhere, you will get a crash."}],"type":"paragraph"}],"name":"Warning","type":"aside"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/superwallkit\/paywallview\/init(placement:params:paywalloverrides:onrequestdismiss:onskippedview:feature:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallSkippedReason":{"title":"PaywallSkippedReason","url":"\/documentation\/superwallkit\/paywallskippedreason","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallSkippedReason","kind":"identifier"}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason","kind":"symbol","navigatorTitle":[{"text":"PaywallSkippedReason","kind":"identifier"}],"abstract":[{"text":"The reason the paywall presentation was skipped.","type":"text"}],"type":"topic","role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallResult":{"navigatorTitle":[{"text":"PaywallResult","kind":"identifier"}],"abstract":[{"type":"text","text":"Contains the possible reasons for the dismissal of a paywall."}],"type":"topic","title":"PaywallResult","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallResult","url":"\/documentation\/superwallkit\/paywallresult","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallResult","kind":"identifier"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallInfo":{"title":"PaywallInfo","kind":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallInfo","role":"symbol","url":"\/documentation\/superwallkit\/paywallinfo","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallInfo","kind":"identifier"}],"abstract":[{"text":"Contains information about a paywall.","type":"text"}]