hose parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"onRequestDismiss","content":[{"inlineContent":[{"type":"text","text":"An optional completion block that gets called when the paywall should dismiss. This defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and the SDK"},{"type":"text","text":" "},{"type":"text","text":"will call "},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"type":"text","text":" by default. Otherwise you must perform the dismissal of the paywall."}],"type":"paragraph"}]},{"name":"feature","content":[{"inlineContent":[{"type":"text","text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/superwall.com\/dashboard"},{"type":"text","text":". If the paywall is set to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Non Gated"}]},{"type":"text","text":", this will be called when"},{"type":"text","text":" "},{"type":"text","text":"the paywall is dismissed or if the user is already paying. If the paywall is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Gated"}]},{"type":"text","text":", this will be called only if the user is already paying"},{"type":"text","text":" "},{"type":"text","text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This uses "},{"code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)","type":"codeVoice"},{"type":"text","text":" under the hood."}]},{"type":"aside","style":"warning","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"You’re responsible for the deallocation of this view. If you have a "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" presented somewhere"},{"type":"text","text":" "},{"type":"text","text":"and you try to present the same "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" elsewhere, you will get a crash."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/paywallview\/init(placement:params:paywalloverrides:onrequestdismiss:feature:)"]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallResult":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallResult"}],"kind":"symbol","abstract":[{"type":"text","text":"Contains the possible reasons for the dismissal of a paywall."}],"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallResult","type":"topic","url":"\/documentation\/superwallkit\/paywallresult","navigatorTitle":[{"kind":"identifier","text":"PaywallResult"}],"title":"PaywallResult","role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallInfo":{"abstract":[{"type":"text","text":"Contains information about a paywall."}],"navigatorTitle":[{"kind":"identifier","text":"PaywallInfo"}],"role":"symbol","title":"PaywallInfo","type":"topic","url":"\/documentation\/superwallkit\/paywallinfo","kind":"symbol","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallInfo","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallInfo"}]},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallView/init(placement:params:paywallOverrides:onRequest