{"abstract":[{"type":"text","text":"A SwiftUI paywall view that you can embed into your app."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"params","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"]? = nil, ","kind":"text"},{"text":"paywallOverrides","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PaywallOverrides","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides","kind":"typeIdentifier","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallOverrides"},{"text":"? = nil, ","kind":"text"},{"text":"onRequestDismiss","kind":"externalParam"},{"kind":"text","text":": (("},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallInfo","kind":"typeIdentifier","text":"PaywallInfo","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallInfo"},{"kind":"text","text":", "},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallResult","kind":"typeIdentifier","text":"PaywallResult","preciseIdentifier":"s:12SuperwallKit13PaywallResultO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")? = nil, "},{"text":"onErrorView","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12SuperwallKit11PaywallViewVAAs5NeverORs_rlE07OnErrorD0xmfp","kind":"typeIdentifier","text":"OnErrorView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"feature"},{"text":": (() -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")? = nil)","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the placement, as you have defined on the Superwall dashboard."}]}],"name":"placement"},{"content":[{"inlineContent":[{"type":"text","text":"Optional parameters you’d like to pass with your placement. These can be referenced within the rules"},{"type":"text","text":" "},{"type":"text","text":"of your campaign. Keys beginning with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" are reserved for Superwall and will be dropped. Values can be any"},{"type":"text","text":" "},{"type":"text","text":"JSON encodable value, URLs or Dates. Arrays and dictionaries as values are not supported at this time, and will"},{"type":"text","text":" "},{"type":"text","text":"be dropped."}],"type":"paragraph"}],"name":"params"},{"content":[{"inlineContent":[{"text":"An optional ","type":"text"},{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides","type":"reference","isActive":true},{"type":"text","text":" object whose parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"paywallOverrides"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional completion block that gets called when the paywall should dismiss. This defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and the SDK"},{"type":"text","text":" "},{"type":"text","text":"will call "},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"type":"text","text":" by default. Otherwise you must perform the dismissal of the paywall."}]}],"name":"onRequestDismiss"},{"content":[{"inlineContent":[{"type":"text","text":"A completion block that accepts an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" and returns a "},{"type":"codeVoice","code":"View"},{"type":"text","text":". This will show when the requested"},{"type":"text","text":" "},{"type":"text","text":"paywall is skipped. Defaults to "},{"type":"codeVoice","code":"EmptyView()"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"onErrorView"},{"content":[{"inlineContent":[{"type":"text","text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the"},{"type":"text","text":" "},{"identifier":"https:\/\/superwall.com\/dashboard","type":"reference","isActive":true},{"type":"text","text":". If the paywall is set to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Non Gated"}]},{"type":"text","text":", this will be called when"},{"type":"text","text":" "},{"type":"text","text":"the paywall is dismissed or if the user is already paying. If the paywall is "},{"type":"emphasis","inlineContent":[{"text":"Gated","type":"text"}]},{"type":"text","text":", this will be called only if the user is already paying"},{"type":"text","text":" "},{"type":"text","text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error."}],"type":"paragraph"}],"name":"feature"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This uses "},{"type":"codeVoice","code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)"},{"text":" under the hood.","type":"text"}]},{"type":"aside","name":"Warning","style":"warning","content":[{"inlineContent":[{"type":"text","text":"You’re responsible for the deallocation of this view. If you have a "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" presented somewhere"},{"type":"text","text":" "},{"type":"text","text":"and you try to present the same "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" elsewhere, you will get a crash."}],"type":"paragraph"}]}]}],"metadata":{"role":"symbol","externalID":"s:12SuperwallKit11PaywallViewVAAs5NeverORs_rlE9placement6params16paywallOverrides16onRequestDismiss0j5ErrorD07featureACyxAEGSS_SDySSypGSgAA0cI0CSgyAA0C4InfoC_AA0C6ResultOtcSgxs0M0_pcyycSgtcfc","symbolKind":"init","modules":[{"name":"SuperwallKit"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"params","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"]?, ","kind":"text"},{"text":"paywallOverrides","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PaywallOverrides","kind":"typeIdentifier","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallOverrides"},{"text":"?, ","kind":"text"},{"text":"onRequestDismiss","kind":"externalParam"},{"text":": ((","kind":"text"},{"text":"PaywallInfo","kind":"typeIdentifier","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallInfo"},{"text":", ","kind":"text"},{"text":"PaywallResult","kind":"typeIdentifier","preciseIdentifier":"s:12SuperwallKit13PaywallResultO"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"text":")?, ","kind":"text"},{"text":"onErrorView","kind":"extern