t":"of your campaign. Keys beginning with ","type":"text"},{"type":"codeVoice","code":"$"},{"text":" are reserved for Superwall and will be dropped. Values can be any","type":"text"},{"text":" ","type":"text"},{"text":"JSON encodable value, URLs or Dates. Arrays and dictionaries as values are not supported at this time, and will","type":"text"},{"text":" ","type":"text"},{"text":"be dropped.","type":"text"}]}],"name":"params"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An optional ","type":"text"},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides","isActive":true},{"text":" object whose parameters override the paywall defaults. Use this","type":"text"},{"text":" ","type":"text"},{"text":"to override products and whether it ignores the subscription status. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"paywallOverrides"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An optional completion block that gets called when the paywall should dismiss. This defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and the SDK","type":"text"},{"text":" ","type":"text"},{"text":"will call ","type":"text"},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"text":" by default. Otherwise you must perform the dismissal of the paywall.","type":"text"}]}],"name":"onRequestDismiss"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A completion block that accepts an ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" and returns a ","type":"text"},{"type":"codeVoice","code":"View"},{"text":". This will show when the requested","type":"text"},{"text":" ","type":"text"},{"text":"paywall is skipped. Defaults to ","type":"text"},{"type":"codeVoice","code":"EmptyView()"},{"text":".","type":"text"}]}],"name":"onErrorView"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/superwall.com\/dashboard","isActive":true},{"text":". If the paywall is set to ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Non Gated","type":"text"}]},{"text":", this will be called when","type":"text"},{"text":" ","type":"text"},{"text":"the paywall is dismissed or if the user is already paying. If the paywall is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Gated","type":"text"}]},{"text":", this will be called only if the user is already paying","type":"text"},{"text":" ","type":"text"},{"text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error.","type":"text"}]}],"name":"feature"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This uses ","type":"text"},{"type":"codeVoice","code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)"},{"text":" under the hood.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"You’re responsible for the deallocation of this view. If you have a ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" presented somewhere","type":"text"},{"text":" ","type":"text"},{"text":"and you try to present the same ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" elsewhere, you will get a crash.","type":"text"}]}],"style":"warning","name":"Warning"}],"kind":"content"}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallOverrides":{"navigatorTitle":[{"text":"PaywallOverrides","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallOverrides","kind":"identifier"}]