rride the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"onRequestDismiss","content":[{"inlineContent":[{"type":"text","text":"An optional completion block that gets called when the paywall should dismiss. This defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and the SDK"},{"type":"text","text":" "},{"type":"text","text":"will call "},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"type":"text","text":" by default. Otherwise you must perform the dismissal of the paywall."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block that accepts an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" and returns a "},{"type":"codeVoice","code":"View"},{"type":"text","text":". This will show when the requested"},{"type":"text","text":" "},{"type":"text","text":"paywall is skipped. Defaults to "},{"type":"codeVoice","code":"EmptyView()"},{"type":"text","text":"."}]}],"name":"onErrorView"},{"content":[{"inlineContent":[{"text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/superwall.com\/dashboard","type":"reference","isActive":true},{"text":". If the paywall is set to ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Non Gated","type":"text"}]},{"text":", this will be called when","type":"text"},{"text":" ","type":"text"},{"text":"the paywall is dismissed or if the user is already paying. If the paywall is ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Gated"}]},{"text":", this will be called only if the user is already paying","type":"text"},{"text":" ","type":"text"},{"tex