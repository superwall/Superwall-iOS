e dropped. Values can be any"},{"type":"text","text":" "},{"type":"text","text":"JSON encodable value, URLs or Dates. Arrays and dictionaries as values are not supported at this time, and will"},{"type":"text","text":" "},{"type":"text","text":"be dropped."}]}]},{"name":"paywallOverrides","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallOverrides","isActive":true},{"type":"text","text":" object whose parameters override the paywall defaults. Use this"},{"type":"text","text":" "},{"type":"text","text":"to override products and whether it ignores the subscription status. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"onRequestDismiss","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional completion block that gets called when the paywall should dismiss. This defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and the SDK"},{"type":"text","text":" "},{"type":"text","text":"will call "},{"code":"presentationMode.wrappedValue.dismiss()","type":"codeVoice"},{"type":"text","text":" by default. Otherwise you must perform the dismissal of the paywall."}]}]},{"name":"onSkippedView","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block that accepts a "},{"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason","isActive":true},{"type":"text","text":" and returns an "},{"code":"View","type":"codeVoice"},{"type":"text","text":". This will show"},{"type":"text","text":" "},{"type":"text","text":"when the requested paywall is skipped. Defaults to "},{"code":"EmptyView()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"onErrorView","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block that accepts an "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" and returns a "},{"code":"View","type":"codeVoice"},{"type":"text","text":". This will show when the requested"},{"type":"text","text":" "},{"type":"text","text":"paywall is skipped. Defaults to "},{"code":"EmptyView()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"feature","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/superwall.com\/dashboard","isActive":true},{"type":"text","text":". If the paywall is set to "},{"inlineContent":[{"text":"Non Gated","type":"text"}],"type":"emphasis"},{"type":"text","text":", this will be called when"},{"type":"text","text":" "},{"type":"text","text":"the paywall is dismissed or if the user is already paying. If the paywall is "},{"inlineContent":[{"text":"Gated","type":"text"}],"type":"emphasis"},{"type":"text","text":", this will be called only if the user is already paying"},{"type":"text","text":" "},{"type":"text","text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error."}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This uses "},{"type":"codeVoice","code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)"},{"type":"text","text":" under the hood."}]},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You’re responsible for the deallocation of this view. If you have a "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" presented somewhere"},{"type":"text","text":" "},{"type":"text","text":"and you try to present the same "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" elsewhere, you will get a crash."}]}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallView"]]},"kind":"symbol","abstract":[{"type":"text","text":"A SwiftUI paywall view that you can embed into your app."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/paywallview\/init(placement:params:paywalloverrides:onrequestdismiss:onskippedview:onerrorview:feature:)"]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/PaywallView/init(placement:params:paywallOverrides:onRequestDismiss:onSkippedView:onErrorView:feature:)":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallView\/init(placement:params:paywallOverrides:onRequestDismiss:onSkippedView:onErrorView:feature:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"params"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"paywallOverrides"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PaywallOverrides","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallOverrides"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"onRequestDismiss"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","text":"PaywallInfo","preciseIdentifier":"c:@M@SuperwallKit@objc(cs)SWKPaywallInfo"},{"text":", ","kind":"text"},{"text":"PaywallResult","kind":"typeIdentifier","preciseIdentifier":"