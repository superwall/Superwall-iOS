type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}]},{"name":"onRequestDismiss","content":[{"type":"paragraph","inlineContent":[{"text":"An optional completion block that gets called when the paywall should dismiss. This defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and the SDK","type":"text"},{"text":" ","type":"text"},{"text":"will call ","type":"text"},{"type":"codeVoice","code":"presentationMode.wrappedValue.dismiss()"},{"text":" by default. Otherwise you must perform the dismissal of the paywall.","type":"text"}]}]},{"name":"onSkippedView","content":[{"type":"paragraph","inlineContent":[{"text":"A completion block that accepts a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallSkippedReason"},{"text":" and returns an ","type":"text"},{"type":"codeVoice","code":"View"},{"text":". This will show","type":"text"},{"text":" ","type":"text"},{"text":"when the requested paywall is skipped. Defaults to ","type":"text"},{"type":"codeVoice","code":"EmptyView()"},{"text":".","type":"text"}]}]},{"name":"onErrorView","content":[{"type":"paragraph","inlineContent":[{"text":"A completion block that accepts an ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" and returns a ","type":"text"},{"type":"codeVoice","code":"View"},{"text":". This will show when the requested","type":"text"},{"text":" ","type":"text"},{"text":"paywall is skipped. Defaults to ","type":"text"},{"type":"codeVoice","code":"EmptyView()"},{"text":".","type":"text"}]}]},{"name":"feature","content":[{"type":"paragraph","inlineContent":[{"text":"A completion block containing a feature that you wish to paywall. Access to this block is remotely configurable via the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/superwall.com\/dashboard"},{"text":". If the paywall is set to ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Non Gated","type":"text"}]},{"text":", this will be called when","type":"text"},{"text":" ","type":"text"},{"text":"the paywall is dismissed or if the user is already paying. If the paywall is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Gated","type":"text"}]},{"text":", this will be called only if the user is already paying","type":"text"},{"text":" ","type":"text"},{"text":"or if they begin paying. If no paywall is configured, this gets called immediately. This will not be called in the event of an error.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This uses "},{"type":"codeVoice","code":"Superwall\/getPaywall(forPlacement:params:paywallOverrides:delegate:)"},{"type":"text","text":" under the hood."}]},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"You’re responsible for the deallocation of this view. If you have a ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" presented somewhere","type":"text"},{"text":" ","type":"text"},{"text":"and you try to present the same ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" elsewhere, you will get a crash.","type":"text"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/PaywallView"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/superwallkit\/paywallview\/init(placement:params:paywalloverrides:onrequestdismiss:onskippedview:onerrorview:feature:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A SwiftUI paywall view that you can embed into your app.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/