{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"No events are sent to the Superwall servers."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/eventtrackingbehavior\/none"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior"]]},"identifier":{"url":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior\/none","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Case","symbolKind":"case","modules":[{"name":"SuperwallKit"}],"title":"EventTrackingBehavior.none","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"none"}],"externalID":"c:@M@SuperwallKit@E@SWKEventTrackingBehavior@SWKEventTrackingBehaviorNone","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"none"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Install-attribution matching is also skipped — it would otherwise post"},{"type":"text","text":" "},{"type":"text","text":"device metadata to the backend, bypassing the opt-out — and so are the"},{"type":"text","text":" "},{"type":"text","text":"public IP address lookups it uses. Because the match"},{"type":"text","text":" "},{"type":"text","text":"never runs, "},{"type":"codeVoice","code":"acquisition_*"},{"type":"text","text":" user attributes aren’t populated, so audience"},{"type":"text","text":" "},{"type":"text","text":"rules that depend on them won’t match."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enrichment is skipped too, since it posts the user and device attributes,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"demandScore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"demandTier"},{"type":"text","text":" aren’t populated either. Use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior\/superwallOnly"},{"type":"text","text":" instead if you need attribution-based or demand-based"},{"type":"text","text":" "},{"type":"text","text":"targeting with minimal tracking."}]}]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/EventTrackingBehavior/none":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"none","kind":"identifier"}],"title":"EventTrackingBehavior.none","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior\/none","url":"\/documentation\/superwallkit\/eventtrackingbehavior\/none","abstract":[{"text":"No events are sent to the Superwall servers.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/EventTrackingBehavior":{"navigatorTitle":[{"text":"EventTrackingBehavior","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventTrackingBehavior","kind":"identifier"}],"title":"EventTrackingBehavior","identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior","url":"\/documentation\/superwallkit\/eventtrackingbehavior","abstract":[{"text":"Controls which events are sent to the Superwall servers.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/EventTrackingBehavior/superwallOnly":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"te