nce"},{"text":" instead if you need attribution-based or demand-based","type":"text"},{"text":" ","type":"text"},{"text":"targeting with minimal tracking.","type":"text"}]}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior"]]},"abstract":[{"type":"text","text":"No events are sent to the Superwall servers."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/superwallkit\/eventtrackingbehavior\/none"]}],"references":{"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit","title":"SuperwallKit","abstract":[],"url":"\/documentation\/superwallkit","type":"topic","kind":"symbol","role":"collection"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/EventTrackingBehavior/none":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior\/none","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"none","kind":"identifier"}],"title":"EventTrackingBehavior.none","abstract":[{"type":"text","text":"No events are sent to the Superwall servers."}],"url":"\/documentation\/superwallkit\/eventtrackingbehavior\/none","kind":"symbol","type":"topic","role":"symbol"},"doc://superwall-ios.SuperwallKit/documentation/SuperwallKit/EventTrackingBehavior":{"identifier":"doc:\/\/superwall-ios.SuperwallKit\/documentation\/SuperwallKit\/EventTrackingBehavior","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventTrackingBehavior","kind":"identifier"}],"title":"EventTrackingBehavior","abstract":[{"type":"text","text":"Controls which events are sent to the Superwall servers."}],"url":"\/documentation\/superwallkit\/eventtrackingbehavior","kind":"symbol","type":"top